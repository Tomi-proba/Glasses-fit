---
// "Munkáink": the four example sites in pairs, Prémium 3D next to Alap, so the difference is visible.
// Screenshots come from scripts/example-shots.mjs.
import { packageById, priceFrom } from '../config/pricing';
import { url } from '../lib/url';
import { icon } from '../lib/icon';

const WORK = [
  {
    company: 'Aurum Ingatlan', field: 'Luxus ingatlaniroda', base: 'ingatlan',
    premium: ['3D villa a nyitóképen, görgetésre a kamera berepül a házba', 'Ingatlankártyák 3D döntéssel, animált szűrő', 'Parallax, számlálók, sima görgetés'],
    alap: ['Ugyanaz a tartalom: szűrő, galéria, értékbecslés', 'Fotós nyitókép, finom beúszás', 'Nagyon gyors, mindössze 4 KB JavaScript'],
  },
  {
    company: 'Fűszerkert Bisztró', field: 'Étterem', base: 'etterem',
    premium: ['Nyitó animáció: kinyíló 3D fűszertartó szekrény', 'Étlap fűszer-ikonokkal, napi ajánlat', 'Parallax galéria, mozgó részletek'],
    alap: ['Ugyanaz az étlap, napi ajánlat és foglalás', 'Fotós nyitókép, finom beúszás', 'Letisztult, gyors, könnyen frissíthető'],
  },
];
const TIERS = [['premium', 'Prémium 3D'], ['alap', 'Alap']] as const;
const shot = (slug: string, kind: string, w: number) => url(`images/examples/${slug}-${kind}-${w}.webp`);
---
<section id="munkaink" class="section work" aria-labelledby="munkaink-title">
  <div class="container">
    <div class="work-intro">
      <h2 id="munkaink-title" class="display" data-reveal>Munkáink</h2>
      <p class="lede" data-reveal>Két kitalált cég, mindegyik mindkét csomagban. Nézd meg őket egymás mellett: ugyanaz a tartalom, más élmény.</p>
    </div>
    {WORK.map((w) => (
      <article class="work-company" aria-label={w.company}>
        <header class="work-head" data-reveal>
          <h3>{w.company}</h3>
          <p class="muted">{w.field}, kitalált cég</p>
        </header>
        <div class="work-pair" data-stagger>
          {TIERS.map(([tier, label]) => {
            const slug = `${w.base}-${tier}`;
            const pkg = packageById(tier)!;
            return (
              <figure class={`work-card is-${tier}`}>
                <a class="work-shot" href={url(`peldak/${slug}`)} target="_blank" rel="noopener" aria-label={`${w.company}, ${label} mintaoldal megnyitása új lapon`}>
                  <span class="browser" aria-hidden="true">
                    <span class="browser-bar"><i></i><i></i><i></i><span>Mintaoldal · {w.company}</span></span>
                    <img src={shot(slug, 'desktop', 720)} srcset={`${shot(slug, 'desktop', 720)} 720w, ${shot(slug, 'desktop', 1280)} 1280w`}
                      sizes={tier === 'premium' ? '(max-width: 900px) 100vw, 58vw' : '(max-width: 900px) 100vw, 42vw'} width="1280" height="800" alt="" loading="lazy" decoding="async" />
                  </span>
                  <img class="phone" src={shot(slug, 'mobile', 390)} width="390" height="844" alt="" loading="lazy" decoding="async" />
                </a>
                <figcaption>
                  <p class="work-tag"><span>{label}</span>{priceFrom(pkg.priceFrom)}</p>
                  <ul class="work-points" role="list">
                    {(tier === 'premium' ? w.premium : w.alap).map((p) => <li><Fragment set:html={icon(tier === 'premium' ? 'sparkles' : 'check')} />{p}</li>)}
                  </ul>
                  <div class="work-actions">
                    <a class="btn btn-sm" href={url(`peldak/${slug}`)} target="_blank" rel="noopener">Megnézem <Fragment set:html={icon('arrow')} /><span class="sr-only"> (új lapon nyílik)</span></a>
                    <a class="link" href={url(`ajanlatkeres?csomag=${tier}&minta=${slug}`)}>Ilyet szeretnék</a>
                  </div>
                </figcaption>
              </figure>
            );
          })}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .work { border-top: 1px solid var(--line); }
  .work-intro { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 24px 48px; align-items: end; margin-bottom: clamp(48px, 7vw, 96px); }
  .work-company + .work-company { margin-top: clamp(72px, 10vw, 136px); }
  .work-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 20px; margin-bottom: 28px; border-bottom: 1px solid var(--line); }
  .work-head h3 { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.4rem); letter-spacing: -0.025em; }
  .work-pair { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(20px, 2.6vw, 36px); align-items: start; }
  .work-card { margin: 0; display: grid; gap: 22px; }
  .work-shot { position: relative; display: block; padding: 0 0 28px; text-decoration: none; }
  .browser { display: block; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); background: var(--surface); box-shadow: 0 40px 80px -48px rgba(0, 0, 0, 0.9); transition: transform 0.7s var(--ease), border-color 0.4s; }
  .browser-bar { display: flex; align-items: center; gap: 6px; height: 30px; padding: 0 12px; border-bottom: 1px solid var(--line); font-family: var(--font-mono); font-size: 10.5px; color: var(--muted); }
  .browser-bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--line-strong); }
  .browser-bar span { margin-left: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .browser img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; transition: transform 1.2s var(--ease); }
  .phone { position: absolute; right: clamp(-8px, -1vw, 0px); bottom: 0; width: 23%; min-width: 72px; height: auto; border-radius: 16px; border: 4px solid #1d1d1d; box-shadow: 0 30px 50px -24px #000; transition: transform 0.7s var(--ease); }
  .is-alap .phone { width: 28%; }
  .work-shot:hover .browser, .work-shot:focus-visible .browser { transform: translateY(-6px); border-color: var(--line-strong); }
  .work-shot:hover .browser img { transform: scale(1.025); }
  .work-shot:hover .phone, .work-shot:focus-visible .phone { transform: translateY(-14px) rotate(-2deg); }
  .work-shot:focus-visible { outline: none; }
  .work-shot:focus-visible .browser { outline: 2px solid var(--accent); outline-offset: 4px; }
  .work-tag { display: flex; align-items: center; gap: 12px; font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  .work-tag span { padding: 5px 12px; border-radius: 999px; font-family: var(--font-body); font-size: 13px; font-weight: 500; background: var(--surface-2); color: var(--text); }
  .is-premium .work-tag span { background: var(--accent); color: var(--on-accent); }
  .work-points { display: grid; gap: 10px; }
  .work-points li { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 10px; font-size: 15px; color: var(--muted); }
  .work-points :global(.icon) { width: 18px; height: 18px; margin-top: 3px; color: var(--accent); }
  .is-alap .work-points :global(.icon) { color: var(--muted); }
  .work-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 4px; }
  @media (max-width: 900px) {
    .work-intro, .work-pair { grid-template-columns: 1fr; }
    .work-pair { gap: 56px; }
    .work-head { flex-direction: column; gap: 4px; }
  }
</style>
