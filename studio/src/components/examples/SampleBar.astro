---
// Floating strip on every example site: says it is a sample and leads to the studio's quote form.
import { packageById, priceFrom } from '../../config/pricing';
import { business } from '../../config/business';
import { url } from '../../lib/url';
import { icon } from '../../lib/icon';
interface Props { tier: 'premium' | 'alap'; slug: string }
const { tier, slug } = Astro.props;
const pkg = packageById(tier)!;
---
<aside class="sample-bar" aria-label="Mintaoldal">
  <a class="sb-home" href={url('')} aria-label={`Vissza a ${business.name} oldalára`}>
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="9" stroke="currentColor" stroke-width="1.6" /><path d="M9.5 22.5 22.5 9.5" stroke="#00d4ff" stroke-width="2.2" stroke-linecap="round" /></svg>
  </a>
  <p class="sb-text"><strong>Ez egy mintaoldal</strong><span>{pkg.name}, {priceFrom(pkg.priceFrom)}</span></p>
  <a class="sb-cta" href={url(`ajanlatkeres?csomag=${tier}&minta=${slug}`)}>Ilyet szeretnék <Fragment set:html={icon('next')} /></a>
  <button class="sb-close" type="button" aria-label="Sáv elrejtése"><Fragment set:html={icon('close')} /></button>
</aside>

<style is:global>
  /* A thin strip, not a floating pill: it should read as a note on the sample, not part of it. */
  .sample-bar {
    position: fixed; z-index: 90; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 18px;
    padding: 10px clamp(16px, 4.4vw, 64px) calc(10px + env(safe-area-inset-bottom)); background: #0b0b0b; color: #f2f2ef; border-top: 1px solid #2a2a2a;
    font: 400 12px/1.4 'Geist', ui-sans-serif, system-ui, sans-serif; letter-spacing: 0.04em; transition: transform 0.4s, opacity 0.3s;
  }
  .sample-bar[hidden] { display: none; }
  html.is-loading .sample-bar { opacity: 0; pointer-events: none; }
  .sb-home { display: grid; place-items: center; width: 22px; height: 22px; color: inherit; flex: none; }
  .sb-home svg { width: 20px; height: 20px; }
  .sb-text { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 0 auto 0 0; min-width: 0; }
  .sb-text strong { font-weight: 500; }
  .sb-text span { color: #9c9c97; }
  .sb-cta { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border: 1px solid #00d4ff; color: #00d4ff; text-decoration: none; text-transform: uppercase; letter-spacing: 0.14em; white-space: nowrap; flex: none; }
  .sb-cta:hover { background: #00d4ff; color: #041014; }
  .sb-cta .icon { width: 14px; height: 14px; }
  .sb-close { border: 0; background: none; color: #9c9c97; cursor: pointer; padding: 6px; display: grid; place-items: center; flex: none; }
  .sb-close:hover { color: #fff; }
  .sb-close .icon { width: 14px; height: 14px; }
  .sample-bar :focus-visible { outline: 1px solid #00d4ff; outline-offset: 3px; }
  @media (max-width: 480px) { .sb-text span { display: none; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.sample-bar');
  try { if (sessionStorage.getItem('sample-bar:hidden')) bar!.hidden = true; } catch { /* storage off */ }
  bar?.querySelector('.sb-close')?.addEventListener('click', () => {
    bar.hidden = true;
    try { sessionStorage.setItem('sample-bar:hidden', '1'); } catch { /* storage off */ }
  });
</script>
