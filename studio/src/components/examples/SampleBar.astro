---
// Floating strip on every example site: says it is a sample and leads to the studio's quote form.
import { packageById, priceFrom } from '../../config/pricing';
import { business } from '../../config/business';
import { url } from '../../lib/url';
import { icon } from '../../lib/icon';
interface Props { tier: 'premium' | 'alap'; slug: string }
const { tier, slug } = Astro.props;
const pkg = packageById(tier)!;
---
<aside class="sample-bar" aria-label="Mintaoldal">
  <a class="sb-home" href={url('')} aria-label={`Vissza a ${business.name} oldalára`}>
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="9" stroke="currentColor" stroke-width="1.6" /><path d="M9.5 22.5 22.5 9.5" stroke="#00d4ff" stroke-width="2.2" stroke-linecap="round" /></svg>
  </a>
  <p class="sb-text"><strong>Ez egy mintaoldal</strong><span>{pkg.name}, {priceFrom(pkg.priceFrom)}</span></p>
  <a class="sb-cta" href={url(`ajanlatkeres?csomag=${tier}&minta=${slug}`)}>Ilyet szeretnék <Fragment set:html={icon('next')} /></a>
  <button class="sb-close" type="button" aria-label="Sáv elrejtése"><Fragment set:html={icon('close')} /></button>
</aside>

<style is:global>
  .sample-bar {
    position: fixed; z-index: 90; left: 50%; bottom: max(16px, env(safe-area-inset-bottom)); transform: translateX(-50%);
    display: flex; align-items: center; gap: 12px; padding: 6px 6px 6px 8px; max-width: calc(100% - 24px);
    border-radius: 999px; background: rgba(12, 12, 12, 0.82); color: #f4f4f2; border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(14px) saturate(1.3); -webkit-backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: 0 18px 50px -18px rgba(0, 0, 0, 0.6);
    font: 400 13.5px/1.25 'Onest', ui-sans-serif, system-ui, sans-serif; letter-spacing: 0;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s;
  }
  .sample-bar[hidden] { display: none; }
  html.is-intro .sample-bar { opacity: 0; pointer-events: none; transform: translate(-50%, 20px); }
  .sb-home { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; color: inherit; flex: none; }
  .sb-home svg { width: 24px; height: 24px; }
  .sb-text { display: grid; gap: 1px; margin: 0; min-width: 0; }
  .sb-text strong { font-weight: 500; }
  .sb-text span { color: #a8a8a3; font-size: 12px; white-space: nowrap; }
  .sb-cta {
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 999px; flex: none;
    background: #00d4ff; color: #041014; font-weight: 500; text-decoration: none; white-space: nowrap; transition: background-color 0.2s, transform 0.2s;
  }
  .sb-cta:hover { background: #fff; }
  .sb-cta:active { transform: scale(0.97); }
  .sb-cta .icon { width: 16px; height: 16px; }
  .sb-close { display: grid; place-items: center; width: 30px; height: 30px; border: 0; border-radius: 50%; background: transparent; color: #a8a8a3; cursor: pointer; flex: none; }
  .sb-close:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
  .sb-close .icon { width: 15px; height: 15px; }
  .sample-bar :focus-visible { outline: 2px solid #00d4ff; outline-offset: 2px; }
  @media (max-width: 480px) { .sb-text span { display: none; } .sample-bar { gap: 8px; } }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.sample-bar');
  try { if (sessionStorage.getItem('sample-bar:hidden')) bar!.hidden = true; } catch { /* storage off */ }
  bar?.querySelector('.sb-close')?.addEventListener('click', () => {
    bar.hidden = true;
    try { sessionStorage.setItem('sample-bar:hidden', '1'); } catch { /* storage off */ }
  });
</script>
