---
// A responsive WebP photo from the example photo slots, or a labelled placeholder until it is downloaded.
import { photo } from '../../examples/photos';
interface Props { slot: string; sizes?: string; class?: string; eager?: boolean; alt?: string }
const { slot, sizes = '(max-width: 760px) 100vw, 50vw', class: cls = '', eager = false, alt } = Astro.props;
const p = photo(slot);
---
{p.ready ? (
  <img class={`ph-img ${cls}`} src={p.src} srcset={p.srcset} sizes={sizes} alt={alt ?? p.alt} width={p.width} height={p.height}
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
) : (
  <div class={`ph-img ph-empty ${cls}`} role="img" aria-label={alt ?? p.alt} style={`aspect-ratio: ${p.ratio[0]} / ${p.ratio[1]}`}>
    <span class="ph-label"><span class="ph-kicker">Fotó helye</span>{alt ?? p.alt}</span>
  </div>
)}

<style is:global>
  .ph-img { display: block; width: 100%; height: auto; object-fit: cover; }
  .ph-empty {
    position: relative; display: grid; place-items: end start; overflow: hidden; padding: 16px;
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, color-mix(in srgb, currentColor 5%, transparent) 14px 15px),
      color-mix(in srgb, currentColor 7%, transparent);
    outline: 1px dashed color-mix(in srgb, currentColor 28%, transparent); outline-offset: -1px;
  }
  .ph-label { display: grid; gap: 4px; max-width: 32ch; font-size: 13px; line-height: 1.35; opacity: 0.75; }
  .ph-kicker { font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.8; }
</style>
