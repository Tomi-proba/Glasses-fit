---
// A 3D object built from a flat image (see src/template/hero3d.js); the still image is the fallback.
import { url } from '../lib/url';
interface Props { image: string; alt: string; effect?: 'particles' | 'relief'; accent?: string }
const { image, alt, effect = 'particles', accent = '#00d4ff' } = Astro.props;
---
<figure class="stage3d" data-image={url(image)} data-effect={effect} data-accent={accent}>
  <img class="stage3d-still" src={url(image)} alt={alt} width="640" height="640" fetchpriority="high" decoding="async" />
  <canvas class="stage3d-canvas" aria-hidden="true"></canvas>
</figure>

<style>
  .stage3d { position: relative; aspect-ratio: 1; width: 100%; }
  .stage3d-still { position: absolute; inset: 14%; width: 72%; height: 72%; object-fit: contain; opacity: 0.85; transition: opacity 0.8s var(--ease); }
  .stage3d-canvas { position: absolute; inset: 0; width: 100% !important; height: 100% !important; opacity: 0; transition: opacity 0.8s var(--ease); }
  .stage3d:global(.is-live) .stage3d-canvas { opacity: 1; }
  .stage3d:global(.is-live) .stage3d-still { opacity: 0; }
</style>

<script>
  import { hasFastWebGL } from '../lib/gpu';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const start = async () => {
    for (const stage of document.querySelectorAll<HTMLElement>('.stage3d')) {
      if (reduce || !hasFastWebGL()) return;
      const { createHero3D } = await import('../template/hero3d.js');
      await createHero3D(stage.querySelector('canvas'), {
        type: stage.dataset.effect,
        image: stage.dataset.image,
        accent: stage.dataset.accent,
        light: false,
        mobile: matchMedia('(max-width: 760px), (pointer: coarse)').matches,
      }).catch(() => null);
    }
  };
  const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 400));
  if (document.readyState === 'complete') idle();
  else addEventListener('load', idle, { once: true });
</script>
