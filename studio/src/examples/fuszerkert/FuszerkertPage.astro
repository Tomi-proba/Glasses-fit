---
// Fűszerkert Bisztró example. Scenes: the opening (scroll-driven video on Prémium, a photo on Alap),
// a printed-menu page, today's dish on a full picture, the kitchen, a film strip of photos (pinned
// and scrolled sideways on Prémium), one review at a time, booking, the map.
import Photo from '../../components/examples/Photo.astro';
import ScrollSequence from '../../components/examples/ScrollSequence.astro';
import { brand, hours, menu, specials, SPICES, gallery, reviews, formatFt } from './content';
import '../exhibit.css';
import './fuszerkert.css';

interface Props { tier: 'premium' | 'alap' }
const { tier } = Astro.props;
const premium = tier === 'premium';
const { lat, lon } = brand.map;
const bbox = [lon - 0.008, lat - 0.004, lon + 0.008, lat + 0.004].join(',');
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lon}`;
const DAYS = ['Vasárnap', 'Hétfő', 'Kedd', 'Szerda', 'Csütörtök', 'Péntek', 'Szombat'];
const week = [2, 3, 4, 5, 6, 0].map((d) => ({ d, day: DAYS[d], ...specials[d]! }));
const times = Array.from({ length: 20 }, (_, i) => `${String(12 + Math.floor(i / 2)).padStart(2, '0')}:${i % 2 ? '30' : '00'}`);
const captions = ['Báránycsülök rozmaringgal', 'A belső terem', 'Hétfőn pörkölt fűszerek', 'Szilvás pite', 'Villányi kékfrankos', 'Sütőtökkrémleves'];
---
<a class="x-sr" href="#tartalom">Ugrás a tartalomra</a>
<header class="x-header">
  <a class="x-mark" href="#" aria-label={`${brand.name}, vissza a lap tetejére`}>Fűszerkert</a>
  <nav class="x-nav" id="fk-nav" aria-label="Fő navigáció">
    <a href="#etlap">Étlap</a>
    <a href="#ma">Ma</a>
    <a href="#foglalas">Foglalás</a>
    <a href="#itt">Itt vagyunk</a>
  </nav>
  <button class="x-menu" type="button" aria-expanded="false" aria-controls="fk-nav">Menü</button>
</header>

<main id="tartalom">
  {premium ? (
    <ScrollSequence name="fuszerkert-spices" fallback="fuszerkert/spices" label="Nyitó jelenet: fűszerek közelről" brand="Fűszerkert" length={3} loader grain class="fk-seq">
      <div class="x-frame" aria-hidden="true"></div>
      <div class="seq-layer fk-l1" data-in="0" data-out="0.3" data-static>
        <h1 id="fk-title" class="x-display">Ami ma reggel a piacon volt, az délben a tányéron.</h1>
        <p class="x-measure">Klauzál tér 9. Kedd és vasárnap között délben és este.</p>
        <div class="x-actions">
          <a class="x-btn is-solid" href="#foglalas">Asztalfoglalás</a>
          <a class="x-link" href="#etlap">Étlap</a>
        </div>
      </div>
      <div class="seq-layer fk-l2" data-in="0.42" data-out="0.68">
        <p class="x-display">A paprikát Kalocsáról hozzuk.</p>
      </div>
      <div class="seq-layer fk-l3" data-in="0.8" data-out="1">
        <p class="x-display">Hetente kétszer őrölünk.</p>
      </div>
      <p class="x-corner l" aria-hidden="true" data-open-now><span data-open-text>Kedd-vasárnap nyitva</span></p>
      <p class="x-corner r" aria-hidden="true">Görgess</p>
    </ScrollSequence>
  ) : (
    <section class="x-scene fk-hero" aria-labelledby="fk-title">
      <div class="x-bleed"><Photo slot="fuszerkert/hero" eager sizes="100vw" /></div>
      <div class="x-veil"></div>
      <div class="x-frame" aria-hidden="true"></div>
      <div class="x-over x-pad fk-hero-copy">
        <h1 id="fk-title" class="x-display">Ami ma reggel a piacon volt, az délben a tányéron.</h1>
        <p class="x-measure">Klauzál tér 9. Kedd és vasárnap között délben és este.</p>
        <div class="x-actions">
          <a class="x-btn is-solid" href="#foglalas">Asztalfoglalás</a>
          <a class="x-link" href="#etlap">Étlap</a>
        </div>
      </div>
      <p class="x-corner l" aria-hidden="true" data-open-now><span data-open-text>Kedd-vasárnap nyitva</span></p>
    </section>
  )}

  <section id="etlap" class="x-plate x-pad fk-menu" aria-labelledby="fk-menu-title">
    <div class="fk-menu-head">
      <h2 id="fk-menu-title" class="x-display" data-reveal>Étlap</h2>
      <div class="fk-tabs" role="tablist" aria-label="Étlap kategóriák">
        {menu.map((c, i) => (
          <button type="button" role="tab" class="x-label" id={`tab-${c.id}`} aria-controls={`panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{c.title}</button>
        ))}
      </div>
    </div>
    {menu.map((c, i) => (
      <div class="fk-panel" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} hidden={i !== 0} tabindex="0">
        <ol class="x-list fk-dishes">
          {c.dishes.map((d, k) => (
            <li class="fk-dish">
              <span class="fk-d-n x-dim">{String(k + 1).padStart(2, '0')}</span>
              <span class="fk-d-name x-label">{d.name}{d.veg && <span class="x-dim"> (v)</span>}</span>
              <span class="fk-d-desc x-dim">{d.desc}, <span class="fk-spice">{SPICES[d.spice].label}</span></span>
              <span class="fk-d-price">{formatFt(d.price)}</span>
            </li>
          ))}
        </ol>
      </div>
    ))}
    <p class="x-dim fk-menu-note">(v) vegetáriánus. Az árak forintban, a szervizdíjat nem számolunk fel.</p>
  </section>

  <section id="ma" class="x-scene fk-today" aria-labelledby="fk-today-title">
    <div class="x-bleed" data-zoom><Photo slot="fuszerkert/daily" sizes="100vw" /></div>
    <div class="x-veil"></div>
    <div class="x-over x-pad fk-today-copy">
      <p class="x-label" data-today-day>A hét ajánlatai</p>
      <h2 id="fk-today-title" class="x-display" data-today-name>Minden nap más, a piac alapján</h2>
      <p class="x-measure"><span data-today-desc>Kedden és vasárnap között minden nap új fogás, amíg tart.</span> <span data-today-price></span></p>
      <ol class="fk-week">
        {week.map((w) => <li data-day={w.d}><span class="x-label">{w.day}</span><span>{w.name}</span></li>)}
      </ol>
    </div>
  </section>

  {premium ? (
    <ScrollSequence name="fuszerkert-kitchen" fallback="fuszerkert/kitchen" label="A konyhából" length={2.4} class="fk-seq fk-kitchen">
      <div class="x-frame" aria-hidden="true"></div>
      <div class="seq-layer fk-k1" data-in="0" data-out="0.45" data-static>
        <p class="x-display">A konyha nyitott. Amit eszel, azt látod is készülni.</p>
      </div>
      <div class="seq-layer fk-k2" data-in="0.6" data-out="1">
        <p class="x-display">Szalai Márton tíz évig főzött Lisszabonban és Isztambulban.</p>
      </div>
    </ScrollSequence>
  ) : (
    <section class="x-scene fk-kitchen-still" aria-label="A konyhából">
      <div class="x-bleed"><Photo slot="fuszerkert/kitchen" sizes="100vw" /></div>
      <div class="x-veil"></div>
      <div class="x-over x-pad fk-kitchen-copy"><p class="x-display" data-reveal>A konyha nyitott. Amit eszel, azt látod is készülni.</p></div>
    </section>
  )}

  <section class="fk-strip" aria-label="Fotók" data-strip>
    <div class="fk-strip-track" data-strip-track>
      {gallery.map((g, i) => (
        <figure class="fk-frame">
          <Photo slot={g} sizes="(max-width: 760px) 90vw, 46vw" />
          <figcaption class="x-label x-dim"><span>{String(i + 1).padStart(2, '0')}</span>{captions[i]}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="x-plate x-pad fk-quote" aria-label="Vendégeink mondták">
    {reviews.map((r, i) => (
      <figure class="fk-q" hidden={i !== 0} data-quote>
        <blockquote><p class="x-display">„{r.quote}”</p></blockquote>
        <figcaption class="x-dim">{r.name}, {r.source}</figcaption>
      </figure>
    ))}
    <p class="fk-q-nav">
      <button class="x-link" type="button" data-quote-next>Következő</button>
      <span class="x-label x-dim" data-quote-count>1 / {reviews.length}</span>
    </p>
  </section>

  <section id="foglalas" class="x-plate x-pad fk-booking" aria-labelledby="fk-book-title">
    <div class="fk-book-copy">
      <h2 id="fk-book-title" class="x-display" data-reveal>Asztalfoglalás</h2>
      <p class="x-dim x-measure">Hétvégére érdemes pár nappal korábban foglalni. Kilenc főtől külön menüt állítunk össze.</p>
      <dl class="fk-hours">
        {hours.map((h) => <div data-days={h.days}><dt>{h.days}</dt><dd>{h.time}</dd></div>)}
      </dl>
    </div>
    <form class="x-form fk-form" novalidate data-booking>
      <div class="fk-row3">
        <div class="x-field"><label for="b-date">Nap</label><input id="b-date" name="date" type="date" required aria-describedby="b-date-err" /><p class="x-err" id="b-date-err"></p></div>
        <div class="x-field"><label for="b-time">Időpont</label><select id="b-time" name="time" required aria-describedby="b-time-err"><option value="">Válassz</option>{times.map((t) => <option>{t}</option>)}</select><p class="x-err" id="b-time-err"></p></div>
        <div class="x-field"><label for="b-guests">Fő</label><select id="b-guests" name="guests" required aria-describedby="b-guests-err">{[1, 2, 3, 4, 5, 6, 7, 8].map((n) => <option selected={n === 2}>{n}</option>)}<option value="9+">9 vagy több</option></select><p class="x-err" id="b-guests-err"></p></div>
      </div>
      <div class="x-field"><label for="b-name">Név</label><input id="b-name" name="name" autocomplete="name" required aria-describedby="b-name-err" /><p class="x-err" id="b-name-err"></p></div>
      <div class="x-row">
        <div class="x-field"><label for="b-phone">Telefon</label><input id="b-phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="b-phone-err" /><p class="x-err" id="b-phone-err"></p></div>
        <div class="x-field"><label for="b-email">E-mail</label><input id="b-email" name="email" type="email" autocomplete="email" required aria-describedby="b-email-err" /><p class="x-err" id="b-email-err"></p></div>
      </div>
      <div class="x-field"><label for="b-note">Megjegyzés</label><textarea id="b-note" name="note" rows="2" placeholder="Allergia, születésnap, teraszra kérnénk"></textarea></div>
      <div class="x-actions"><button class="x-btn is-solid" type="submit">Foglalok</button></div>
      <p class="x-status fk-status" role="status" aria-live="polite"></p>
    </form>
  </section>

  <section id="itt" class="x-scene fk-contact" aria-labelledby="fk-contact-title">
    <iframe class="fk-map" src={mapSrc} title={`${brand.name} a térképen`} loading="lazy" referrerpolicy="no-referrer"></iframe>
    <div class="x-over x-pad fk-contact-copy">
      <h2 id="fk-contact-title" class="x-display" data-reveal>Klauzál tér 9.</h2>
      <dl class="fk-contact-list">
        <div><dt class="x-label x-dim">Telefon</dt><dd><a href={`tel:${brand.phone.replace(/\s/g, '')}`}>{brand.phone}</a></dd></div>
        <div><dt class="x-label x-dim">E-mail</dt><dd><a href={`mailto:${brand.email}`}>{brand.email}</a></dd></div>
        <div><dt class="x-label x-dim">Villamos</dt><dd>Wesselényi utca / Erzsébet körút, négy perc gyalog</dd></div>
      </dl>
    </div>
  </section>
</main>

<footer class="x-pad fk-footer">
  <p class="x-label">Fűszerkert Bisztró</p>
  <p class="x-dim">Kitalált étterem, ez a weboldal minta. © {new Date().getFullYear()}</p>
</footer>

<script type="application/json" id="fk-specials" set:html={JSON.stringify({ specials })} />
