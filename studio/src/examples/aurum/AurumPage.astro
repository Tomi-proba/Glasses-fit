---
// Aurum Ingatlan example. Scenes instead of sections: the picture is the page, the interface is a
// thin layer of small text and 1px lines. Prémium: the walkthrough video scrubbed by scroll, hover
// previews in the catalogue. Alap: the same scenes with still photos and a single fade.
import Photo from '../../components/examples/Photo.astro';
import ScrollSequence from '../../components/examples/ScrollSequence.astro';
import { brand, properties, services, agents, testimonials, faq, FILTERS, formatHuf } from './content';
import '../exhibit.css';
import './aurum.css';

interface Props { tier: 'premium' | 'alap' }
const { tier } = Astro.props;
const premium = tier === 'premium';
const { lat, lon } = brand.map;
const bbox = [lon - 0.012, lat - 0.006, lon + 0.012, lat + 0.006].join(',');
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lon}`;
const pad = (n: number) => String(n).padStart(2, '0');
---
<a class="x-sr" href="#tartalom">Ugrás a tartalomra</a>
<header class="x-header">
  <a class="x-mark" href="#" aria-label={`${brand.name}, vissza a lap tetejére`}>Aurum</a>
  <nav class="x-nav" id="au-nav" aria-label="Fő navigáció">
    <a href="#kinalat">Kínálat</a>
    <a href="#iroda">Iroda</a>
    <a href="#ertekbecsles">Értékbecslés</a>
    <a href="#kapcsolat">Kapcsolat</a>
  </nav>
  <button class="x-menu" type="button" aria-expanded="false" aria-controls="au-nav">Menü</button>
</header>

<main id="tartalom">
  {premium ? (
    <ScrollSequence name="aurum-walk" fallback="aurum/hero" label="Bemutató: séta egy eladó házban" brand="Aurum" length={3.4} loader grain class="au-seq">
      <div class="x-frame" aria-hidden="true"></div>
      <div class="seq-layer au-l1" data-in="0" data-out="0.3">
        <h1 id="au-title" class="x-display">Otthonok Budán és a Balaton-felvidéken.</h1>
        <p class="x-measure">Évente negyven megbízást vállalunk. Mindegyik házat személyesen bejárjuk, mielőtt fotó készül róla.</p>
      </div>
      <div class="seq-layer au-l2" data-in="0.5" data-out="0.72">
        <p class="x-display">Lépj be.</p>
      </div>
      <div class="seq-layer au-l3" data-in="0.84" data-out="1" data-static>
        <p class="x-hotspot au-spot" aria-hidden="true"><i></i>Nappali, 64 m²</p>
        <div class="x-actions">
          <a class="x-btn is-solid" href="#kinalat">Kínálat</a>
          <a class="x-link" href="#ertekbecsles">Értékbecslés kérése</a>
        </div>
      </div>
      <p class="x-corner l" aria-hidden="true">Szépvölgy, Budapest II.</p>
      <p class="x-corner r au-scroll-hint" aria-hidden="true">Görgess</p>
    </ScrollSequence>
  ) : (
    <section class="x-scene au-hero" aria-labelledby="au-title">
      <div class="x-bleed"><Photo slot="aurum/hero" eager sizes="100vw" /></div>
      <div class="x-veil"></div>
      <div class="x-frame" aria-hidden="true"></div>
      <div class="x-over x-pad au-hero-copy">
        <h1 id="au-title" class="x-display">Otthonok Budán és a Balaton-felvidéken.</h1>
        <p class="x-measure">Évente negyven megbízást vállalunk. Mindegyik házat személyesen bejárjuk, mielőtt fotó készül róla.</p>
        <div class="x-actions">
          <a class="x-btn is-solid" href="#kinalat">Kínálat</a>
          <a class="x-link" href="#ertekbecsles">Értékbecslés kérése</a>
        </div>
      </div>
      <p class="x-corner l" aria-hidden="true">Szépvölgy, Budapest II.</p>
    </section>
  )}

  <section id="kinalat" class="x-plate x-pad au-catalogue" aria-labelledby="au-cat-title">
    <div class="au-cat-head">
      <h2 id="au-cat-title" class="x-display" data-reveal>Kínálat</h2>
      <p class="x-dim au-cat-note" data-reveal>Hat ingatlan, mindegyiket bejártuk. A nem nyilvános ajánlatokról személyesen beszélünk.</p>
    </div>
    <form class="au-filter" aria-label="Szűrés" data-filter>
      <fieldset class="au-types">
        <legend class="x-sr">Típus</legend>
        <label><input type="radio" name="type" value="" checked /><span class="x-label">Mind</span></label>
        {FILTERS.type.map((t) => <label><input type="radio" name="type" value={t} /><span class="x-label">{t}</span></label>)}
      </fieldset>
      <label class="au-sel"><span class="x-label x-dim">Ár</span>
        <select name="price"><option value="">Bármennyi</option>{FILTERS.price.map(([v, t]) => <option value={v}>{t}</option>)}</select>
      </label>
      <label class="au-sel"><span class="x-label x-dim">Szoba</span>
        <select name="rooms"><option value="">Bármennyi</option>{FILTERS.rooms.map((r) => <option value={r}>{r} vagy több</option>)}</select>
      </label>
      <p class="x-label x-dim au-count" role="status" aria-live="polite" data-count-label>{properties.length} ingatlan</p>
    </form>
    <ol class="x-list au-rows" data-cards>
      {properties.map((p, i) => (
        <li class="au-card au-row" data-type={p.type} data-price={p.price} data-rooms={p.rooms} data-preview={p.id}>
          <button class="au-row-btn" type="button" data-open={p.id} aria-haspopup="dialog">
            <span class="au-c-n x-dim">{pad(i + 1)}</span>
            {!premium && <span class="au-c-thumb"><Photo slot={p.photos[0]} sizes="120px" /></span>}
            <span class="au-c-title">{p.title}</span>
            <span class="au-c-loc x-dim">{p.location}</span>
            <span class="au-c-size x-dim">{p.area} m², {p.rooms} szoba</span>
            <span class="au-c-price">{formatHuf(p.price)}</span>
          </button>
        </li>
      ))}
    </ol>
    <div class="au-empty" data-empty hidden>
      <p>Ezekkel a feltételekkel most nincs ingatlanunk. Írj, és szólunk, ha lesz.</p>
      <button class="x-link" type="button" data-reset>Szűrők törlése</button>
    </div>
    {premium && (
      <div class="au-preview" aria-hidden="true" data-preview-box>
        {properties.map((p) => <figure data-preview-img={p.id}><Photo slot={p.photos[0]} sizes="360px" alt="" /></figure>)}
      </div>
    )}
  </section>

  <section id="iroda" class="x-scene au-office" aria-labelledby="au-office-title">
    <div class="x-bleed" data-zoom><Photo slot="aurum/about" sizes="100vw" /></div>
    <div class="x-veil"></div>
    <div class="x-over x-pad au-office-copy">
      <h2 id="au-office-title" class="x-display" data-reveal>Kevesebb ház, több idő mindegyikre.</h2>
      <ol class="au-services" data-reveal>
        {services.map((s, i) => <li><span class="x-dim">{pad(i + 1)}</span>{s.text}</li>)}
      </ol>
    </div>
  </section>

  <section class="x-plate x-pad au-team" aria-labelledby="au-team-title">
    <h2 id="au-team-title" class="x-display" data-reveal>Hárman vagyunk.</h2>
    <ul class="x-list au-agents">
      {agents.map((a) => (
        <li class="au-agent" data-reveal>
          <span class="au-a-photo"><Photo slot={a.photo} sizes="160px" /></span>
          <span class="au-a-name">{a.name}</span>
          <span class="x-dim">{a.area}</span>
          <a class="au-a-phone" href={`tel:${a.phone.replace(/\s/g, '')}`}>{a.phone}</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="x-plate x-pad au-quote" aria-label="Ügyfeleink mondták" data-quotes>
    {testimonials.map((t, i) => (
      <figure class="au-q" hidden={i !== 0} data-quote>
        <blockquote><p class="x-display">„{t.quote}”</p></blockquote>
        <figcaption class="x-dim">{t.name}, {t.role}</figcaption>
      </figure>
    ))}
    <p class="au-q-nav">
      <button class="x-link" type="button" data-quote-next>Következő vélemény</button>
      <span class="x-label x-dim" data-quote-count>1 / {testimonials.length}</span>
    </p>
  </section>

  <section id="ertekbecsles" class="x-scene au-val" aria-labelledby="au-val-title">
    <div class="x-bleed"><Photo slot="aurum/valuation" sizes="100vw" /></div>
    <div class="au-val-veil"></div>
    <div class="x-over x-pad au-val-grid">
      <div>
        <h2 id="au-val-title" class="x-display" data-reveal>Mennyit ér az otthonod?</h2>
        <p class="x-measure" data-reveal>Két munkanapon belül írásban küldjük, friss eladási adatok alapján. Ingyenes.</p>
      </div>
      <form class="x-form au-form" novalidate data-valuation>
        <div class="x-row">
          <div class="x-field"><label for="v-name">Név</label><input id="v-name" name="name" autocomplete="name" required aria-describedby="v-name-err" /><p class="x-err" id="v-name-err"></p></div>
          <div class="x-field"><label for="v-phone">Telefon</label><input id="v-phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="v-phone-err" /><p class="x-err" id="v-phone-err"></p></div>
        </div>
        <div class="x-field"><label for="v-email">E-mail</label><input id="v-email" name="email" type="email" autocomplete="email" required aria-describedby="v-email-err" /><p class="x-err" id="v-email-err"></p></div>
        <div class="x-field"><label for="v-address">Az ingatlan címe</label><input id="v-address" name="address" autocomplete="street-address" required aria-describedby="v-address-err" /><p class="x-err" id="v-address-err"></p></div>
        <div class="x-row">
          <div class="x-field"><label for="v-type">Típus</label><select id="v-type" name="type" required aria-describedby="v-type-err"><option value="">Válassz</option>{FILTERS.type.map((t) => <option>{t}</option>)}<option>Telek</option></select><p class="x-err" id="v-type-err"></p></div>
          <div class="x-field"><label for="v-area">Alapterület, m²</label><input id="v-area" name="area" inputmode="numeric" required aria-describedby="v-area-err" /><p class="x-err" id="v-area-err"></p></div>
        </div>
        <label class="x-check"><input type="checkbox" name="consent" required aria-describedby="v-consent-err" /><span>Felhívhattok az értékbecslés miatt.</span></label>
        <p class="x-err" id="v-consent-err"></p>
        <div class="x-actions"><button class="x-btn is-solid" type="submit">Kérem az értékbecslést</button></div>
        <p class="x-status au-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section id="gyik" class="x-plate x-pad au-faq" aria-labelledby="au-faq-title">
    <h2 id="au-faq-title" class="x-display" data-reveal>Kérdések</h2>
    <dl class="au-faq-list">
      {faq.map(([q, a]) => (
        <div data-reveal><dt>{q}</dt><dd class="x-dim">{a}</dd></div>
      ))}
    </dl>
  </section>

  <section id="kapcsolat" class="x-scene au-contact" aria-labelledby="au-contact-title">
    <iframe class="au-map" src={mapSrc} title={`${brand.name} irodája a térképen`} loading="lazy" referrerpolicy="no-referrer"></iframe>
    <div class="x-over x-pad au-contact-copy">
      <h2 id="au-contact-title" class="x-display" data-reveal>Kiss János altábornagy utca 27.</h2>
      <dl class="au-contact-list" data-reveal>
        <div><dt class="x-label x-dim">Cím</dt><dd>{brand.address}</dd></div>
        <div><dt class="x-label x-dim">Telefon</dt><dd><a href={`tel:${brand.phone.replace(/\s/g, '')}`}>{brand.phone}</a></dd></div>
        <div><dt class="x-label x-dim">E-mail</dt><dd><a href={`mailto:${brand.email}`}>{brand.email}</a></dd></div>
        <div><dt class="x-label x-dim">Nyitva</dt><dd>{brand.hours}</dd></div>
      </dl>
    </div>
  </section>
</main>

<footer class="x-pad au-footer">
  <p class="x-label">Aurum Ingatlan</p>
  <p class="x-dim">Kitalált cég, ez a weboldal minta. © {new Date().getFullYear()}</p>
</footer>

<dialog class="x-dialog au-dialog" aria-labelledby="au-dialog-title" data-dialog>
  <div class="au-dialog-inner" data-dialog-body></div>
  <button class="x-close" type="button" data-close>Bezárás</button>
</dialog>

{/* Each property's full details, in the HTML for search engines; the dialog shows a copy. */}
{properties.map((p, i) => (
  <article id={`tpl-${p.id}`} class="au-source" aria-labelledby={`au-t-${p.id}`} hidden>
    <div class="au-gallery" data-gallery>
      <div class="au-slides" data-slides tabindex="0" aria-label={`${p.title} fotói`} role="region">
        {p.photos.map((ph, k) => <div class="au-slide" aria-label={`${k + 1}. kép a ${p.photos.length}-ből`} role="group"><Photo slot={ph} sizes="(max-width: 900px) 100vw, 62vw" /></div>)}
      </div>
      <p class="au-gal-nav">
        <button class="x-link" type="button" data-step="-1">Előző</button>
        <span class="x-label" aria-hidden="true"><span data-current>1</span> / {p.photos.length}</span>
        <button class="x-link" type="button" data-step="1">Következő</button>
      </p>
    </div>
    <div class="au-detail">
      <p class="x-label x-dim">{pad(i + 1)}, {p.type}, {p.location}</p>
      <h2 id={`au-t-${p.id}`} class="x-display">{p.title}</h2>
      <dl class="au-specs">
        <div><dt class="x-dim">Ár</dt><dd>{formatHuf(p.price)}</dd></div>
        <div><dt class="x-dim">Alapterület</dt><dd>{p.area} m²</dd></div>
        {p.lot && <div><dt class="x-dim">Telek</dt><dd>{new Intl.NumberFormat('hu-HU').format(p.lot)} m²</dd></div>}
        <div><dt class="x-dim">Szobák</dt><dd>{p.rooms}</dd></div>
        <div><dt class="x-dim">Fürdők</dt><dd>{p.baths}</dd></div>
      </dl>
      {p.description.map((d) => <p>{d}</p>)}
      <p class="x-dim">{p.features.join('. ')}.</p>
      <div class="x-actions"><a class="x-btn is-solid" href="#ertekbecsles" data-close>Bejárást kérek</a></div>
    </div>
  </article>
))}
