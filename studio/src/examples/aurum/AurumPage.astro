---
// Aurum Ingatlan example site. The same content renders as the Prémium 3D or the Alap package sample;
// the route pages load the matching scripts (Three.js and GSAP only for Prémium).
import Photo from '../../components/examples/Photo.astro';
import { brand, stats, properties, services, agents, testimonials, FILTERS, formatHuf } from './content';
import { icon } from '../../lib/icon';
import './aurum.css';

interface Props { tier: 'premium' | 'alap' }
const { tier } = Astro.props;
const premium = tier === 'premium';
const { lat, lon } = brand.map;
const bbox = [lon - 0.012, lat - 0.006, lon + 0.012, lat + 0.006].join(',');
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lon}`;
const nav = [['#ingatlanok', 'Ingatlanok'], ['#szolgaltatasok', 'Szolgáltatások'], ['#csapat', 'Csapat'], ['#ertekbecsles', 'Értékbecslés'], ['#kapcsolat', 'Kapcsolat']];
---
<a class="au-skip" href="#tartalom">Ugrás a tartalomra</a>
<header class="au-header" data-header>
  <div class="au-wrap au-nav">
    <a class="au-logo" href="#" aria-label={`${brand.name}, vissza a lap tetejére`}>
      <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18.5" fill="none" stroke="currentColor" stroke-width="1.2" /><path d="M12 29V19a8 8 0 0 1 16 0v10" fill="none" stroke="var(--gold)" stroke-width="1.6" /><path d="M16.5 29v-7.5a3.5 3.5 0 0 1 7 0V29" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
      <span>Aurum<small>Ingatlan</small></span>
    </a>
    <nav class="au-links" id="au-links" aria-label="Fő navigáció">
      {nav.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="au-btn au-btn-sm au-nav-cta" href="#ertekbecsles">Értékbecslés</a>
    <button class="au-menu" type="button" aria-expanded="false" aria-controls="au-links"><span class="au-sr">Menü</span><Fragment set:html={icon('menu')} /></button>
  </div>
</header>

<main id="tartalom">
  {premium ? (
    <section class="au-hero au-hero-3d" aria-labelledby="au-title" data-hero>
      <div class="au-stage" data-villa>
        <div class="au-stage-poster"><Photo slot="aurum/hero" eager sizes="100vw" /></div>
        <canvas class="au-canvas" aria-hidden="true"></canvas>
      </div>
      <div class="au-hero-shade" aria-hidden="true"></div>
      <div class="au-wrap au-hero-copy">
        <h1 id="au-title" class="au-display" data-hero-line>Kivételes otthonok.<br /><em>Diszkrét képviselet.</em></h1>
        <p class="au-lede" data-hero-line>Prémium ingatlanok Budapesten és a Balaton-felvidéken. Személyes tanácsadó, értékbecslés 48 órán belül.</p>
        <div class="au-actions" data-hero-line>
          <a class="au-btn" href="#ingatlanok">Ingatlanok böngészése <Fragment set:html={icon('next')} /></a>
          <a class="au-btn au-btn-ghost" href="#ertekbecsles">Ingyenes értékbecslés</a>
        </div>
      </div>
      <p class="au-scroll" aria-hidden="true"><span></span>Görgess, és lépj be</p>
    </section>
  ) : (
    <section class="au-hero au-hero-basic" aria-labelledby="au-title">
      <div class="au-wrap au-hero-grid">
        <div class="au-hero-copy">
          <h1 id="au-title" class="au-display">Kivételes otthonok.<br /><em>Diszkrét képviselet.</em></h1>
          <p class="au-lede">Prémium ingatlanok Budapesten és a Balaton-felvidéken. Személyes tanácsadó, értékbecslés 48 órán belül.</p>
          <div class="au-actions">
            <a class="au-btn" href="#ingatlanok">Ingatlanok böngészése <Fragment set:html={icon('next')} /></a>
            <a class="au-btn au-btn-ghost" href="#ertekbecsles">Ingyenes értékbecslés</a>
          </div>
        </div>
        <div class="au-hero-photo"><Photo slot="aurum/hero" eager sizes="(max-width: 900px) 100vw, 55vw" /></div>
      </div>
    </section>
  )}

  <section class="au-stats" aria-label="Számokban">
    <dl class="au-wrap au-stats-grid">
      {stats.map((s) => (
        <div data-reveal>
          <dt>{s.label}</dt>
          <dd><span data-count={s.value} data-decimals={s.decimals ?? 0}>{s.decimals ? s.value.toFixed(1).replace('.', ',') : s.value}</span>{s.suffix}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section id="ingatlanok" class="au-section au-listings" aria-labelledby="au-listings-title">
    <div class="au-wrap">
      <div class="au-head">
        <h2 id="au-listings-title" class="au-h2" data-reveal>Kiemelt ingatlanok</h2>
        <p class="au-muted" data-reveal>Válogatás a jelenlegi kínálatunkból. Minden ingatlant személyesen bejártunk és ellenőriztünk.</p>
      </div>

      <form class="au-filter" aria-label="Szűrés" data-filter data-reveal>
        <fieldset class="au-chips">
          <legend class="au-sr">Típus</legend>
          <label><input type="radio" name="type" value="" checked /><span>Összes</span></label>
          {FILTERS.type.map((t) => <label><input type="radio" name="type" value={t} /><span>{t}</span></label>)}
        </fieldset>
        <div class="au-selects">
          <label class="au-select"><span>Ár</span>
            <select name="price"><option value="">Bármennyi</option>{FILTERS.price.map(([v, t]) => <option value={v}>{t}</option>)}</select>
          </label>
          <label class="au-select"><span>Szobák</span>
            <select name="rooms"><option value="">Bármennyi</option>{FILTERS.rooms.map((r) => <option value={r}>{r}+ szoba</option>)}</select>
          </label>
        </div>
        <p class="au-count" role="status" aria-live="polite" data-count-label>{properties.length} ingatlan</p>
      </form>

      <ul class="au-cards" role="list" data-cards>
        {properties.map((p) => (
          <li class="au-card" data-type={p.type} data-price={p.price} data-rooms={p.rooms} style={`view-transition-name: card-${p.id}`}>
            <button class="au-card-btn" type="button" data-open={p.id} aria-haspopup="dialog">
              <span class="au-card-media" data-tilt>
                <Photo slot={p.photos[0]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw" />
                {p.badge && <span class="au-badge">{p.badge}</span>}
                <span class="au-glare" aria-hidden="true"></span>
              </span>
              <span class="au-card-body">
                <span class="au-card-top"><span class="au-type">{p.type}</span><span class="au-price">{formatHuf(p.price)}</span></span>
                <span class="au-card-title">{p.title}</span>
                <span class="au-card-loc"><Fragment set:html={icon('pin')} />{p.location}</span>
                <span class="au-specs">
                  <span><Fragment set:html={icon('bed')} />{p.rooms} szoba</span>
                  <span><Fragment set:html={icon('bath')} />{p.baths} fürdő</span>
                  <span><Fragment set:html={icon('ruler')} />{p.area} m²</span>
                </span>
              </span>
            </button>
          </li>
        ))}
      </ul>
      <div class="au-empty" data-empty hidden>
        <p>Ezekkel a feltételekkel most nincs ingatlan a kínálatban. Írj nekünk, és szólunk, ha jön ilyen.</p>
        <button class="au-btn au-btn-ghost au-btn-sm" type="button" data-reset>Szűrők törlése</button>
      </div>
    </div>
  </section>

  <section id="szolgaltatasok" class="au-section au-about" aria-labelledby="au-about-title">
    <div class="au-wrap au-about-grid">
      <div class="au-about-photo" data-parallax><Photo slot="aurum/about" sizes="(max-width: 900px) 100vw, 45vw" /></div>
      <div class="au-about-copy">
        <h2 id="au-about-title" class="au-h2" data-reveal>Egy tanácsadó, az első bejárástól a kulcsátadásig.</h2>
        <p class="au-muted au-about-lede" data-reveal>Nem adunk el mindent. Évente legfeljebb negyven megbízást vállalunk, így minden ingatlanra és minden ügyfélre jut idő.</p>
        <ul class="au-services" role="list">
          {services.map((s) => (
            <li data-reveal><span class="au-ic" set:html={icon(s.icon)} /><div><h3>{s.title}</h3><p class="au-muted">{s.text}</p></div></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="csapat" class="au-section au-team" aria-labelledby="au-team-title">
    <div class="au-wrap">
      <div class="au-head">
        <h2 id="au-team-title" class="au-h2" data-reveal>Ismerd meg a csapatot</h2>
        <p class="au-muted" data-reveal>Mindegyikünk egy területre szakosodott, így olyan tanácsadóval dolgozol, aki ismeri a környéket.</p>
      </div>
      <ul class="au-agents" role="list">
        {agents.map((a) => (
          <li class="au-agent" data-reveal>
            <div class="au-agent-photo"><Photo slot={a.photo} sizes="(max-width: 700px) 100vw, 33vw" /></div>
            <h3>{a.name}</h3>
            <p class="au-muted">{a.role} · {a.area}</p>
            <a class="au-link" href={`tel:${a.phone.replace(/\s/g, '')}`}>{a.phone}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="au-section au-quotes" aria-labelledby="au-quotes-title">
    <div class="au-wrap">
      <h2 id="au-quotes-title" class="au-h2" data-reveal>Ügyfeleink mondták</h2>
      <ul class="au-quote-list" role="list">
        {testimonials.map((t) => (
          <li data-reveal>
            <blockquote>
              <span class="au-qmark" set:html={icon('quote')} />
              <p>{t.quote}</p>
              <footer><strong>{t.name}</strong><span class="au-muted">{t.role}</span></footer>
            </blockquote>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="ertekbecsles" class="au-section au-valuation" aria-labelledby="au-val-title">
    <div class="au-wrap au-val-grid">
      <div class="au-val-copy">
        <h2 id="au-val-title" class="au-h2" data-reveal>Mennyit ér az otthonod?</h2>
        <p class="au-muted" data-reveal>Add meg az ingatlan adatait, és 48 órán belül írásos értékbecslést küldünk friss tranzakciós adatok alapján. Ingyenes, és nem kötelez semmire.</p>
        <div class="au-val-photo" data-parallax><Photo slot="aurum/valuation" sizes="(max-width: 900px) 100vw, 40vw" /></div>
      </div>
      <form class="au-form" novalidate data-valuation data-reveal>
        <div class="au-row">
          <div class="au-field"><label for="v-name">Név</label><input id="v-name" name="name" autocomplete="name" required aria-describedby="v-name-err" /><p class="au-err" id="v-name-err"></p></div>
          <div class="au-field"><label for="v-phone">Telefon</label><input id="v-phone" name="phone" type="tel" autocomplete="tel" required aria-describedby="v-phone-err" /><p class="au-err" id="v-phone-err"></p></div>
        </div>
        <div class="au-field"><label for="v-email">E-mail</label><input id="v-email" name="email" type="email" autocomplete="email" required aria-describedby="v-email-err" /><p class="au-err" id="v-email-err"></p></div>
        <div class="au-field"><label for="v-address">Az ingatlan címe</label><input id="v-address" name="address" autocomplete="street-address" required aria-describedby="v-address-err" placeholder="Település, utca, házszám" /><p class="au-err" id="v-address-err"></p></div>
        <div class="au-row">
          <div class="au-field"><label for="v-type">Típus</label><select id="v-type" name="type" required aria-describedby="v-type-err"><option value="">Válassz</option>{FILTERS.type.map((t) => <option>{t}</option>)}<option>Telek</option></select><p class="au-err" id="v-type-err"></p></div>
          <div class="au-field"><label for="v-area">Alapterület (m²)</label><input id="v-area" name="area" inputmode="numeric" required aria-describedby="v-area-err" /><p class="au-err" id="v-area-err"></p></div>
        </div>
        <div class="au-field"><label for="v-note">Megjegyzés <span class="au-muted">nem kötelező</span></label><textarea id="v-note" name="note" rows="3"></textarea></div>
        <label class="au-check"><input type="checkbox" name="consent" required aria-describedby="v-consent-err" /><span>Hozzájárulok, hogy az értékbecsléshez felvegyék velem a kapcsolatot.</span></label>
        <p class="au-err" id="v-consent-err"></p>
        <button class="au-btn" type="submit">Értékbecslést kérek <Fragment set:html={icon('next')} /></button>
        <p class="au-form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section id="kapcsolat" class="au-section au-contact" aria-labelledby="au-contact-title">
    <div class="au-wrap au-contact-grid">
      <div>
        <h2 id="au-contact-title" class="au-h2" data-reveal>Látogass meg az irodában</h2>
        <dl class="au-contact-list" data-reveal>
          <div><dt>Cím</dt><dd>{brand.address}</dd></div>
          <div><dt>Telefon</dt><dd><a class="au-link" href={`tel:${brand.phone.replace(/\s/g, '')}`}>{brand.phone}</a></dd></div>
          <div><dt>E-mail</dt><dd><a class="au-link" href={`mailto:${brand.email}`}>{brand.email}</a></dd></div>
          <div><dt>Nyitvatartás</dt><dd>{brand.hours}</dd></div>
        </dl>
      </div>
      <div class="au-map" data-reveal>
        <iframe src={mapSrc} title={`${brand.name} irodája a térképen`} loading="lazy" referrerpolicy="no-referrer"></iframe>
      </div>
    </div>
  </section>
</main>

<footer class="au-footer">
  <div class="au-wrap au-footer-grid">
    <p class="au-footer-brand">{brand.name}<span class="au-muted">{brand.tagline}</span></p>
    <p class="au-muted">© {new Date().getFullYear()} {brand.name}. Kitalált cég, a weboldal minta.</p>
  </div>
</footer>

<dialog class="au-dialog" aria-labelledby="au-dialog-title" data-dialog>
  <div class="au-dialog-inner" data-dialog-body></div>
  <button class="au-dialog-close" type="button" data-close aria-label="Bezárás"><Fragment set:html={icon('close')} /></button>
</dialog>

{properties.map((p) => (
  <template id={`tpl-${p.id}`}>
    <div class="au-gallery" data-gallery>
      <div class="au-slides" data-slides tabindex="0" aria-label={`${p.title} fotói`} role="region">
        {p.photos.map((ph, i) => <div class="au-slide" aria-label={`${i + 1}. kép a ${p.photos.length}-ből`} role="group"><Photo slot={ph} sizes="(max-width: 900px) 100vw, 60vw" /></div>)}
      </div>
      <button class="au-gal-btn au-gal-prev" type="button" data-step="-1" aria-label="Előző kép"><Fragment set:html={icon('caretLeft')} /></button>
      <button class="au-gal-btn au-gal-next" type="button" data-step="1" aria-label="Következő kép"><Fragment set:html={icon('caretRight')} /></button>
      <p class="au-gal-count" aria-hidden="true"><span data-current>1</span> / {p.photos.length}</p>
    </div>
    <div class="au-detail">
      <p class="au-type">{p.type} · {p.location}</p>
      <h2 id="au-dialog-title" class="au-h2">{p.title}</h2>
      <p class="au-detail-price">{formatHuf(p.price)}</p>
      <dl class="au-detail-specs">
        <div><dt>Alapterület</dt><dd>{p.area} m²</dd></div>
        {p.lot && <div><dt>Telek</dt><dd>{new Intl.NumberFormat('hu-HU').format(p.lot)} m²</dd></div>}
        <div><dt>Szobák</dt><dd>{p.rooms}</dd></div>
        <div><dt>Fürdők</dt><dd>{p.baths}</dd></div>
      </dl>
      {p.description.map((d) => <p class="au-muted">{d}</p>)}
      <ul class="au-features" role="list">{p.features.map((f) => <li><Fragment set:html={icon('check')} />{f}</li>)}</ul>
      <a class="au-btn" href="#ertekbecsles" data-close>Bejárást kérek</a>
    </div>
  </template>
))}
