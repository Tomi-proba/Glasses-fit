---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
import { icon } from '../lib/icon';
---
<Layout title="Tervező" description="Tervezd meg a weboldalad lépésről lépésre, élő előnézettel." app>
  <h1 class="sr-only">Weboldal-tervező</h1>
  <div class="cfg" data-view="settings">
    <aside class="cfg-panel" id="panel" aria-label="Beállítások">
      <div class="cfg-progress">
        <div class="progress-top">
          <p id="progress-text" class="mono">1/4 lépés</p>
          <p id="save-status" class="hint" role="status" aria-live="polite">Betöltés…</p>
        </div>
        <div class="progress-track" aria-hidden="true"><i id="progress-bar"></i></div>
        <nav aria-label="Lépések"><ol id="steps" class="steps" role="list"></ol></nav>
      </div>
      <form class="cfg-body" id="step-body" autocomplete="off" novalidate></form>
      <footer class="cfg-nav">
        <button type="button" class="btn btn-ghost" data-action="prev">{'Vissza'}</button>
        <a id="next-link" class="btn" href={url('osszegzes')}>Tovább</a>
      </footer>
    </aside>

    <section class="cfg-preview" aria-label="Élő előnézet">
      <div class="preview-bar">
        <div class="devices" role="group" aria-label="Előnézet mérete">
          <button type="button" data-device="desktop" aria-pressed="true"><Fragment set:html={icon('desktop')} /><span>Asztali</span></button>
          <button type="button" data-device="mobile" aria-pressed="false"><Fragment set:html={icon('mobile')} /><span>Mobil</span></button>
        </div>
        <button type="button" class="btn btn-sm btn-ghost" data-action="reset">Újrakezdés</button>
      </div>
      <div class="frame-wrap" id="frame-wrap" data-device="desktop">
        <iframe id="preview" src={url('sablon/elonezet')} title="A weboldalad élő előnézete"></iframe>
      </div>
    </section>

    <nav class="cfg-switch" aria-label="Nézet váltása">
      <button type="button" data-view="settings" aria-pressed="true"><Fragment set:html={icon('pen')} />Beállítások</button>
      <button type="button" data-view="preview" aria-pressed="false"><Fragment set:html={icon('eye')} />Előnézet</button>
    </nav>
  </div>
  <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
</Layout>

<script>
  import { initConfigurator } from '../lib/configurator.js';
  initConfigurator();
</script>

<style is:global>
  .cfg { display: grid; grid-template-columns: minmax(360px, 460px) minmax(0, 1fr); height: calc(100dvh - var(--header-h)); border-top: 1px solid var(--line); }
  .cfg-panel { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; min-height: 0; border-right: 1px solid var(--line); background: var(--bg); }
  .cfg-panel > * { min-width: 0; }
  .cfg-panel { min-width: 0; overflow: hidden; }

  .cfg-progress { padding: 16px 20px 0; border-bottom: 1px solid var(--line); }
  .progress-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .progress-top .hint { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .progress-top .mono { color: var(--accent); }
  .progress-track { height: 2px; background: var(--line); border-radius: 2px; margin-top: 10px; overflow: hidden; }
  .progress-track i { display: block; height: 100%; background: var(--accent); transition: width 0.5s var(--ease); }
  .steps { display: flex; gap: 2px; padding: 10px 0; min-height: 56px; overflow-x: auto; scrollbar-width: none; }
  .steps button { display: flex; align-items: center; gap: 8px; padding: 7px 10px 7px 7px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font-size: 13.5px; cursor: pointer; white-space: nowrap; transition: background-color 0.2s, color 0.2s; }
  .steps button:hover { color: var(--text); background: var(--surface); }
  .steps .num { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; border: 1px solid var(--line-strong); font-family: var(--font-mono); font-size: 10px; }
  .steps .num .icon { width: 12px; height: 12px; }
  .steps button.done .num { border-color: transparent; background: var(--surface-2); color: var(--accent); }
  .steps button[aria-current='step'] { color: var(--text); background: var(--surface); }
  .steps button:not([aria-current='step']) .txt { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .steps button[aria-current='step'] .num { background: var(--accent); color: var(--on-accent); border-color: transparent; }

  .cfg-body { overflow-y: auto; padding: 24px 20px 48px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; align-content: start; overscroll-behavior: contain; }
  .blk-editor, .group-body, .item, .list-field { grid-template-columns: minmax(0, 1fr); }
  .cfg-body > h2 { font-size: 1.9rem; outline: none; }
  .cfg-body .lead { color: var(--muted); margin-top: -8px; }
  .cfg-body .sub { font-family: var(--font-body); font-size: 13px; font-weight: 500; color: var(--muted); margin-top: 12px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .row.three { grid-template-columns: 0.8fr 0.6fr 1.4fr; }
  .row > .field { min-width: 0; }
  .suggest { display: grid; gap: 8px; justify-items: start; padding: 14px; border: 1px dashed var(--line-strong); border-radius: var(--r-input); }

  .segmented { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; padding: 4px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); }
  .segmented label { position: relative; }
  .segmented input { position: absolute; opacity: 0; }
  .segmented span { display: block; text-align: center; padding: 8px; border-radius: 999px; cursor: pointer; color: var(--muted); font-size: 14px; }
  .segmented input:checked + span { background: var(--surface-2); color: var(--text); }
  .segmented input:focus-visible + span { outline: 2px solid var(--accent); }

  .swatches { display: flex; flex-wrap: wrap; gap: 8px; }
  .swatch { width: 34px; height: 34px; border-radius: 50%; border: 2px solid transparent; background: var(--c); box-shadow: inset 0 0 0 3px var(--bg); cursor: pointer; transition: transform 0.15s; }
  .swatch:hover { transform: scale(1.08); }
  .swatch.on { border-color: var(--text); }
  .color-row { display: flex; gap: 8px; margin-top: 4px; }
  .color-row input[type='color'] { width: 46px; height: 44px; padding: 3px; border-radius: var(--r-input); border: 1px solid var(--line); background: var(--surface); cursor: pointer; }
  #accent-hex { flex: 1; padding: 10px 12px; border-radius: var(--r-input); border: 1px solid var(--line); background: var(--surface); font-family: var(--font-mono); font-size: 13px; }
  input[type='range'] { width: 100%; accent-color: var(--accent); }

  .choices { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .choice { position: relative; display: grid; gap: 8px; padding: 10px; border-radius: var(--r-input); border: 1px solid var(--line); background: var(--surface); cursor: pointer; font-size: 13px; line-height: 1.3; transition: border-color 0.2s; }
  .choice input { position: absolute; opacity: 0; }
  .choice:has(input:checked) { border-color: var(--accent); }
  .choice:has(input:focus-visible) { outline: 2px solid var(--accent); }
  .choice-art { aspect-ratio: 16 / 10; border-radius: 6px; background: var(--bg); }
  .art-particles { background: radial-gradient(circle, var(--text) 0.8px, transparent 1.4px) 0 0 / 6px 6px, var(--bg); -webkit-mask: radial-gradient(circle at 50% 50%, #000 34%, transparent 36%); mask: radial-gradient(circle at 50% 50%, #000 34%, transparent 36%); }
  .art-relief { background: radial-gradient(circle at 44% 40%, #fff, #6a6a68 26%, transparent 31%), radial-gradient(circle at 50% 50%, var(--accent) 30%, transparent 33%), var(--bg); }
  .art-none { background: radial-gradient(circle at 50% 50%, var(--line-strong) 30%, transparent 31%), var(--bg); }

  .img-row { display: flex; gap: 12px; align-items: center; }
  .thumb { width: 72px; height: 72px; border-radius: var(--r-input); overflow: hidden; border: 1px solid var(--line); background: repeating-conic-gradient(var(--surface-2) 0 25%, var(--surface) 0 50%) 0 0 / 12px 12px; display: grid; place-items: center; flex: none; }
  .thumb img { width: 100%; height: 100%; object-fit: contain; }
  .thumb span { font-size: 11px; color: var(--muted); }
  .img-actions { display: flex; flex-wrap: wrap; gap: 6px; }
  .file-btn { position: relative; overflow: hidden; }
  .file-btn input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .file-btn:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .img-field > .field { margin-top: 4px; }

  .group { border: 1px solid var(--line); border-radius: var(--r-input); background: var(--bg); }
  .group summary { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; cursor: pointer; list-style: none; font-weight: 500; }
  .group summary::-webkit-details-marker { display: none; }
  .group summary .icon { color: var(--muted); transition: transform 0.3s var(--ease); }
  .group[open] summary .icon { transform: rotate(45deg); }
  .group-body { display: grid; gap: 14px; padding: 0 16px 16px; }
  .item { display: grid; gap: 12px; padding: 12px; border-radius: var(--r-input); background: var(--surface); border: 1px solid var(--line); }
  .item.compact { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
  .item-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .item-head strong { display: flex; align-items: center; gap: 8px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; font-size: 14px; }
  .icon.mini { width: 16px; height: 16px; color: var(--accent); }
  .item-tools { display: flex; gap: 4px; }
  .icon-btn { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--line); background: var(--bg); color: var(--text); cursor: pointer; }
  .icon-btn .icon { width: 15px; height: 15px; }
  .icon-btn:hover:not(:disabled) { border-color: var(--line-strong); }
  .icon-btn:disabled { opacity: 0.3; cursor: default; }
  .icon-btn.danger:hover { color: var(--danger); border-color: var(--danger); }

  .sec-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .sec-item { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: var(--r-input); border: 1px solid var(--line); background: var(--surface); }
  .sec-item.off .sec-name { color: var(--muted); text-decoration: line-through; }
  .sec-item.dragging { opacity: 0.4; }
  .handle { color: var(--muted); cursor: grab; display: grid; }
  .sec-name { flex: 1; text-align: left; border: 0; background: none; padding: 6px 0; cursor: pointer; font-weight: 500; }
  .sec-name:hover { color: var(--accent); }
  .switch { position: relative; display: inline-block; width: 42px; height: 24px; flex: none; }
  .switch input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; z-index: 1; }
  .switch .track { position: absolute; inset: 0; border-radius: 12px; background: var(--line-strong); transition: background-color 0.2s; }
  .switch .track::after { content: ''; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: transform 0.2s var(--ease); }
  .switch input:checked ~ .track { background: var(--accent); }
  .switch input:checked ~ .track::after { transform: translateX(18px); }
  .switch input:focus-visible ~ .track { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* start choices */
  .starts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .start { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: var(--r-input); border: 1px solid var(--line); background: var(--surface); text-align: left; cursor: pointer; transition: border-color 0.2s; }
  .start:hover { border-color: var(--accent); }
  .start strong { display: block; font-weight: 500; font-size: 14px; }
  .start small { display: block; color: var(--muted); font-size: 12px; line-height: 1.3; }
  .start-art { flex: none; width: 44px; height: 44px; border-radius: 8px; background: radial-gradient(circle at 70% 30%, var(--a) 0 28%, transparent 30%), var(--b); border: 1px solid var(--line); display: grid; place-items: center; color: var(--muted); }
  .start-art.blank { background: var(--bg); border-style: dashed; }

  /* toggles */
  .switch-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; cursor: pointer; font-size: 14px; font-weight: 500; }
  .row-actions { display: flex; flex-wrap: wrap; gap: 6px; }
  .danger-text:hover { color: var(--danger); border-color: var(--danger); }

  /* pages and blocks */
  .pages-bar { display: flex; align-items: center; gap: 8px; }
  .page-tabs { display: flex; gap: 4px; flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; padding: 2px; }
  .page-tab button { padding: 7px 12px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--muted); font-size: 13.5px; white-space: nowrap; cursor: pointer; }
  .page-tab.on button { background: var(--text); color: var(--bg); border-color: var(--text); }
  .page-tab.dragging { opacity: 0.4; }
  .blk-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; }
  .blk, .blk-row { min-width: 0; }
  .blk { border-radius: var(--r-input); border: 1px solid var(--line); background: var(--surface); }
  .blk.open { border-color: color-mix(in srgb, var(--accent) 50%, var(--line)); }
  .blk.is-hidden .blk-text { opacity: 0.55; }
  .blk.dragging { opacity: 0.4; }
  .blk-row { display: flex; align-items: center; gap: 6px; padding: 6px 8px 6px 6px; }
  .blk-main { flex: 1; min-width: 0; display: flex; align-items: center; gap: 10px; padding: 4px; border: 0; background: none; text-align: left; cursor: pointer; }
  .blk-icon { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 8px; background: var(--surface-2); color: var(--accent); }
  .blk-icon .icon { width: 17px; height: 17px; }
  .blk-text { min-width: 0; }
  .blk-text strong { display: block; font-weight: 500; font-size: 14px; }
  .blk-text small { display: block; color: var(--muted); font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .blk .item-tools { flex: none; }
  .blk .icon-btn { width: 28px; height: 28px; }
  .blk-editor { display: grid; gap: 14px; padding: 6px 12px 14px; border-top: 1px solid var(--line); padding-top: 14px; }
  .blk-list .empty { padding: 20px; text-align: center; color: var(--muted); border: 1px dashed var(--line-strong); border-radius: var(--r-input); }
  .add-block { justify-self: stretch; background: var(--surface-2); color: var(--text); border: 1px dashed var(--line-strong); }
  .add-block:hover { background: var(--accent); color: var(--on-accent); border-color: transparent; }
  .picker { border: 1px solid var(--line-strong); border-radius: var(--r-input); background: var(--bg); padding: 12px; display: grid; gap: 10px; }
  .picker-head { display: flex; justify-content: space-between; align-items: center; }
  .picker-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .pick { display: flex; gap: 10px; align-items: flex-start; padding: 10px; border-radius: var(--r-input); border: 1px solid var(--line); background: var(--surface); text-align: left; cursor: pointer; transition: border-color 0.2s; }
  .pick:hover, .pick:focus-visible { border-color: var(--accent); }
  .pick > .icon { width: 20px; height: 20px; color: var(--accent); margin-top: 2px; }
  .pick strong { display: block; font-weight: 500; font-size: 13.5px; }
  .pick small { display: block; color: var(--muted); font-size: 12px; line-height: 1.3; }
  .list-field { gap: 10px; }
  .list-field > .btn { justify-self: start; }
  .page-settings summary { font-size: 14px; }

  .cfg-nav { display: flex; justify-content: space-between; gap: 12px; padding: 12px 20px; border-top: 1px solid var(--line); }
  .cfg-nav [data-last='1'] { background: var(--accent); color: var(--on-accent); }

  .cfg-preview { display: grid; grid-template-rows: auto minmax(0, 1fr); min-width: 0; min-height: 0; background: radial-gradient(80% 60% at 50% 0%, #11181b, var(--bg) 70%); }
  .preview-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 20px; }
  .devices { display: flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); }
  .devices button { display: flex; align-items: center; gap: 6px; padding: 6px 12px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font-size: 13.5px; cursor: pointer; }
  .devices button[aria-pressed='true'] { background: var(--surface-2); color: var(--text); }
  .frame-wrap { justify-self: center; width: calc(100% - 40px); height: calc(100% - 20px); margin-bottom: 20px; border-radius: var(--r-media); overflow: hidden; border: 1px solid var(--line); background: #000; box-shadow: 0 40px 100px -30px rgba(0, 0, 0, 0.8); transition: width 0.5s var(--ease); }
  .frame-wrap[data-device='mobile'] { width: 390px; max-width: calc(100% - 40px); border-radius: 30px; border: 8px solid #1d1d1d; }
  .frame-wrap iframe { display: block; width: 100%; height: 100%; border: 0; }

  .cfg-switch { display: none; }
  .toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 60; display: flex; align-items: center; gap: 12px; padding: 10px 12px 10px 18px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line-strong); box-shadow: 0 20px 50px -20px #000; font-size: 14px; max-width: calc(100% - 32px); }
  .toast[hidden] { display: none; }
  .toast[data-kind='err'] { border-color: var(--danger); }
  .toast-action { border: 0; border-radius: 999px; padding: 6px 12px; background: var(--text); color: var(--bg); font-weight: 500; cursor: pointer; white-space: nowrap; }

  @media (max-width: 960px) {
    .cfg { grid-template-columns: 1fr; height: calc(100dvh - var(--header-h) - 64px); }
    .cfg-panel { border-right: 0; }
    .cfg[data-view='preview'] .cfg-panel, .cfg[data-view='settings'] .cfg-preview { display: none; }
    .devices { display: none; }
    .frame-wrap { width: 100%; height: 100%; margin: 0; border-radius: 0; border: 0; }
    .frame-wrap[data-device='mobile'] { width: 100%; max-width: none; border: 0; border-radius: 0; }
    .preview-bar { padding: 8px 12px; }
    .cfg-switch { position: fixed; inset: auto 0 0; z-index: 30; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; height: 64px; padding: 8px 12px calc(8px + env(safe-area-inset-bottom)); background: var(--bg); border-top: 1px solid var(--line); }
    .cfg-switch button { display: flex; align-items: center; justify-content: center; gap: 8px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font-weight: 500; cursor: pointer; }
    .cfg-switch button[aria-pressed='true'] { background: var(--surface); color: var(--text); }
    .toast { bottom: 84px; }
    body.is-app .site-footer { padding-bottom: 96px; }
  }
  @media (max-width: 420px) { .row, .row.three { grid-template-columns: 1fr; } .choices { grid-template-columns: 1fr 1fr; } }
</style>
