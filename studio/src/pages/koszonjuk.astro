---
import Layout from '../layouts/Layout.astro';
import { business } from '../config/business';
import { url } from '../lib/url';
---
<Layout title="Köszönjük az ajánlatkérést" noindex>
  <section class="container thanks">
    <h1 class="display" id="thanks-title">Köszönjük!</h1>
    <p class="lede">24-48 órán belül személyre szabott ajánlattal jelentkezünk.</p>
    <p class="muted" id="thanks-detail" hidden></p>
    <h2 class="next-title">A következő lépések</h2>
    <ol class="next" role="list">
      <li><span class="mono">01</span><div><h3>Ajánlat</h3><p class="muted">Átnézzük, amit küldtél, és e-mailben elküldjük a személyre szabott ajánlatot.</p></div></li>
      <li><span class="mono">02</span><div><h3>Egyeztetés</h3><p class="muted">Ha megfelel, egyeztetjük a részleteket, a szövegeket és a képeket.</p></div></li>
      <li><span class="mono">03</span><div><h3>Elkészítés</h3><p class="muted">Elkészítjük az oldalad, és két körben finomítjuk a visszajelzéseid alapján.</p></div></li>
      <li><span class="mono">04</span><div><h3>Élesítés</h3><p class="muted">Élesítjük a saját domaineden, és megmutatjuk, hogyan kezeld.</p></div></li>
    </ol>
    <p class="muted">Kérdésed van addig is? Írj a <a class="link" href={`mailto:${business.email}`}>{business.email}</a> címre.</p>
    <a class="btn btn-ghost" href={url('')}>Vissza a főoldalra</a>
  </section>
</Layout>

<style>
  .thanks { display: grid; gap: 28px; justify-items: start; padding-block: clamp(56px, 9vw, 120px) var(--section); }
  .thanks h1 { font-size: clamp(2.6rem, 6vw, 5rem); max-width: 14ch; }
  .next-title { font-size: 1.6rem; margin-top: 16px; }
  .next { display: grid; gap: 0; width: 100%; max-width: 720px; }
  .next li { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 12px; padding: 20px 0; border-top: 1px solid var(--line); }
  .next .mono { color: var(--accent); padding-top: 4px; }
  .next h3 { margin-bottom: 6px; }
</style>

<script>
  import { loadLastQuote } from '../lib/store.js';
  const q = loadLastQuote();
  if (q) {
    // Hungarian names put the given name last.
    const first = String(q.name || '').trim().split(/\s+/).pop();
    if (first) document.getElementById('thanks-title')!.textContent = `Köszönjük, ${first}!`;
    const detail = document.getElementById('thanks-detail')!;
    detail.textContent = `Az ajánlatot a(z) ${q.email} címre küldjük.${q.hasDesign ? ' A tervezőben összeállított tervedet is megkaptuk.' : ''} Hivatkozási szám: ${q.requestId}.`;
    detail.hidden = false;
  }
</script>
