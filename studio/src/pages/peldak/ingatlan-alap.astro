---
import ExampleLayout from '../../layouts/ExampleLayout.astro';
import AurumPage from '../../examples/aurum/AurumPage.astro';
import { aurumLd } from '../../examples/aurum/ld';
import { url } from '../../lib/url';

const title = 'Aurum Ingatlan Budapest: kínálat, értékbecslés, kapcsolat';
const description = 'Aurum Ingatlan, 1126 Budapest, Kiss János altábornagy utca 27. Hat eladó ingatlan Budán és a Balaton-felvidéken, díjtalan értékbecslés, 2,5% jutalék. Telefon: +36 1 555 0142.';
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = aurumLd(pageUrl, new URL(url('images/og/ingatlan-alap.jpg'), Astro.site).href);
---
<ExampleLayout {title} {description} {jsonLd} tier="alap" slug="ingatlan-alap" themeColor="#0e0d0b"
  fonts="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,300..500&family=Instrument+Sans:wght@400;500&family=Geist:wght@400;500&display=swap">
  <AurumPage tier="alap" />
</ExampleLayout>

<script>
  import '../../examples/aurum/basic.js';
</script>
