---
// Home: an exhibition of our work. The first scene is an example site's walkthrough video,
// scrubbed by scroll; then quiet typographic scenes with 1px lines. Two text styles only.
import Layout from '../layouts/Layout.astro';
import ScrollSequence from '../components/examples/ScrollSequence.astro';
import Photo from '../components/examples/Photo.astro';
import { business } from '../config/business';
import { PACKAGES, VAT_NOTE, priceFrom } from '../config/pricing';
import { url } from '../lib/url';
import { faqPage } from '../lib/seo';

const [alap, premium] = PACKAGES;
const lowest = priceFrom(alap.priceFrom);
const steps = [
  ['Megtervezed, vagy leírod', 'A tervezőben öt perc alatt összerakod, milyen legyen az oldal. Ha nincs kedved tervezni, pár mondat is elég.'],
  ['Ajánlatot küldünk', 'Két munkanapon belül, fix árral. Az ajánlatkérés ingyenes, és semmire nem kötelez.'],
  ['Elkészítjük', 'A tervedből indulunk, és két körben finomítjuk a visszajelzéseid alapján.'],
  ['Élesítjük', 'Beállítjuk a domaint és a tárhelyet. Az oldal és a forrásfájlok a tieid.'],
];
const rows: [string, string, string][] = [
  ['Ár', priceFrom(alap.priceFrom), priceFrom(premium.priceFrom)],
  ['Havidíj', 'nincs', 'nincs'],
  ...alap.features.map((f): [string, string, string] => [f, 'igen', 'igen']),
  ...premium.features.map((f): [string, string, string] => [f, 'nem', 'igen']),
];
const faq = [
  ['Mennyibe kerül egy weboldal?', `Az Alap ${priceFrom(alap.priceFrom)}, a Prémium ${priceFrom(premium.priceFrom)}. A pontos árat az ajánlatban írjuk meg, attól függően, hány oldal kell, és megvannak-e már a szövegek és a fotók.`],
  ['Kötelez valamire az ajánlatkérés?', 'Nem. Csak akkor kezdünk dolgozni, ha elfogadtad az ajánlatot.'],
  ['Azt kapom, amit a tervezőben összeraktam?', 'A terv a kiindulás. A végleges oldalt mi készítjük el, olyan részletekkel is, amiket a tervezőben nem lehet beállítani.'],
  ['Mennyi idő alatt készül el?', 'Általában egy-két hét az ajánlat elfogadásától, ha a szövegek és a képek megvannak.'],
  ['Kell ÁFA-t fizetni?', `Nem. ${VAT_NOTE} Havidíj sincs. A domaint és a tárhelyet a szolgáltatónak fizeted, ebben segítünk.`],
  ['Mi van, ha nincs saját fotóm?', 'Szerzünk jogtiszta képeket, vagy szervezünk fotózást. Az ajánlatkérőben jelezheted, mi van meg.'],
];
---
<Layout immersive jsonLd={[faqPage(faq as [string, string][])]}>
  <ScrollSequence name="aurum-walk" fallback="aurum/hero" label="Munkáink: egy ingatlaniroda mintaoldalának bemutatója" length={3} grain class="h-seq">
    <div class="h-frame" aria-hidden="true"></div>
    <div class="seq-layer h-l1" data-in="0" data-out="0.3">
      <h1 class="display">Weboldalak, amiket végignéznek.</h1>
      <p class="h-small">Tervezd meg öt perc alatt, a többit mi intézzük. Weboldal {lowest}, havidíj nélkül.</p>
      <p class="h-actions">
        <a class="btn h-btn" href={url('tervezo')}>Tervezd meg</a>
        <a class="link" href={url('ajanlatkeres')}>Ajánlatot kérek</a>
      </p>
    </div>
    <div class="seq-layer h-l2" data-in="0.46" data-out="0.7">
      <p class="display">Görgess, és belépsz a házba.</p>
    </div>
    <div class="seq-layer h-l3" data-in="0.82" data-out="1" data-static>
      <p class="label">Aurum Ingatlan, Prémium mintaoldal</p>
      <p class="h-actions">
        <a class="btn h-btn" href={url('peldak/ingatlan-premium')}>Megnézem</a>
        <a class="link" href={url('ajanlatkeres?csomag=premium&minta=ingatlan-premium')}>Ilyet szeretnék</a>
      </p>
    </div>
    <p class="h-corner l label" aria-hidden="true">01, Munkáink</p>
    <p class="h-corner r label" aria-hidden="true">Görgess</p>
  </ScrollSequence>

  <section id="folyamat" class="container h-plate" aria-labelledby="folyamat-title">
    <h2 id="folyamat-title" class="display" data-reveal>Négy lépés.</h2>
    <ol class="h-steps" role="list">
      {steps.map(([t, d], i) => (
        <li data-reveal>
          <span class="mono muted">0{i + 1}</span>
          <h3>{t}</h3>
          <p class="muted">{d}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="munkaink" class="h-work" aria-labelledby="munkaink-title">
    <h2 id="munkaink-title" class="sr-only">Munkáink</h2>
    <article class="h-scene" aria-labelledby="w1">
      <div class="h-bleed"><Photo slot="aurum/p1-3" sizes="100vw" /></div>
      <div class="h-veil"></div>
      <div class="h-frame" aria-hidden="true"></div>
      <div class="container h-scene-copy">
        <p class="label">02, Aurum Ingatlan</p>
        <h3 id="w1" class="display">Ingatlaniroda Budán.</h3>
        <p class="h-small">A Prémium változatban a ház bemutatóvideója görgetésre halad. Az Alap ugyanez állóképekkel.</p>
        <p class="h-actions">
          <a class="btn h-btn" href={url('peldak/ingatlan-premium')}>Prémium</a>
          <a class="link" href={url('peldak/ingatlan-alap')}>Alap</a>
        </p>
      </div>
    </article>
    <article class="container h-exhibit" aria-labelledby="w2">
      <a class="h-print" href={url('peldak/jatekterem-premium')} aria-label="Pixel Pont Játékterem, Prémium mintaoldal">
        <img src={url('images/examples/jatekterem-premium-desktop-1280.webp')} srcset={`${url('images/examples/jatekterem-premium-desktop-720.webp')} 720w, ${url('images/examples/jatekterem-premium-desktop-1280.webp')} 1280w`} sizes="(max-width: 900px) 100vw, 62vw" width="1280" height="800" alt="" loading="lazy" decoding="async" />
      </a>
      <div class="h-exhibit-copy">
        <p class="label">03, Pixel Pont Játékterem</p>
        <h3 id="w2" class="display">Játékterem a Nagy Diófa utcában.</h3>
        <p class="h-small muted">A Prémiumban a látogató bedob egy zsetont, és berepül a játékgép képernyőjébe: ott egy játékmenü az oldal. Az Alap ugyanez a tartalom, egyszerű görgetéssel.</p>
        <p class="h-actions">
          <a class="btn btn-ghost" href={url('peldak/jatekterem-premium')}>Prémium</a>
          <a class="link" href={url('peldak/jatekterem-alap')}>Alap</a>
        </p>
      </div>
    </article>
    <article class="h-scene" aria-labelledby="w3">
      <div class="h-bleed"><img class="ph-img" src={url('examples/pool/08-1100.webp')} srcset={`${url('examples/pool/08-1100.webp')} 1100w, ${url('examples/pool/08-1600.webp')} 1600w`} sizes="100vw" width="1600" height="901" alt="Zárt teleszkópos medencefedés esti kertben" loading="lazy" decoding="async" /></div>
      <div class="h-veil"></div>
      <div class="h-frame" aria-hidden="true"></div>
      <div class="container h-scene-copy">
        <p class="label">04, Kékvíz Medence</p>
        <h3 id="w3" class="display">Medenceépítő Budaörsön.</h3>
        <p class="h-small">Görgetésre felépül a medence az üres kertből, a végén rácsúszik a fedés. A fedést a látogató maga is nyithatja és zárhatja.</p>
        <p class="h-actions">
          <a class="btn h-btn" href={url('peldak/medence-premium')}>Prémium</a>
        </p>
      </div>
    </article>
    <p class="container h-note muted">Mindhárom cég kitalált, az oldalakat mintának készítettük.</p>
  </section>

  <section id="csomagok" class="container h-plate" aria-labelledby="csomagok-title">
    <h2 id="csomagok-title" class="display" data-reveal>Két csomag.</h2>
    <table class="h-table">
      <thead>
        <tr><th scope="col"><span class="sr-only">Tartalom</span></th><th scope="col" class="label">{alap.name}</th><th scope="col" class="label">{premium.name}</th></tr>
      </thead>
      <tbody>
        {rows.map(([k, a, p]) => <tr><th scope="row">{k}</th><td class={a === 'nem' ? 'muted' : ''}>{a}</td><td>{p}</td></tr>)}
      </tbody>
      <tfoot>
        <tr><td></td><td><a class="link" href={url('ajanlatkeres?csomag=alap')}>Ajánlatot kérek</a></td><td><a class="link" href={url('ajanlatkeres?csomag=premium')}>Ajánlatot kérek</a></td></tr>
      </tfoot>
    </table>
    <p class="muted h-small">{VAT_NOTE} A pontos árat az ajánlatban adjuk meg.</p>
  </section>

  <section id="gyik" class="container h-plate h-faq" aria-labelledby="gyik-title">
    <h2 id="gyik-title" class="display" data-reveal>Kérdések.</h2>
    <div class="h-faq-list">
      {faq.map(([q, a]) => (
        <details>
          <summary><span>{q}</span><span class="h-plus" aria-hidden="true">+</span></summary>
          <p class="muted">{a}</p>
        </details>
      ))}
    </div>
  </section>

  <section id="kapcsolat" class="container h-plate h-contact" aria-labelledby="kapcsolat-title">
    <div>
      <h2 id="kapcsolat-title" class="display"><a href={`mailto:${business.email}`}>{business.email}</a></h2>
      <p class="h-small muted">Egy munkanapon belül válaszolunk. Telefonon: <a class="link" href={`tel:${business.phone.replace(/\s/g, '')}`}>{business.phone}</a></p>
    </div>
    <form class="contact-form" data-email={business.email} novalidate>
      <div class="field"><label for="c-name">Név</label><input id="c-name" name="name" autocomplete="name" required aria-describedby="c-name-err" /><p class="field-err" id="c-name-err"></p></div>
      <div class="field"><label for="c-email">E-mail</label><input id="c-email" name="email" type="email" autocomplete="email" required aria-describedby="c-email-err" /><p class="field-err" id="c-email-err"></p></div>
      <div class="field"><label for="c-msg">Üzenet</label><textarea id="c-msg" name="message" rows="3" required aria-describedby="c-msg-err"></textarea><p class="field-err" id="c-msg-err"></p></div>
      <p><button class="btn" type="submit">Küldés</button></p>
      <p class="hint" role="status" aria-live="polite"></p>
    </form>
  </section>
</Layout>

<style is:global>
  /* hero scene */
  .h-seq .seq-shade { background: linear-gradient(90deg, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.1) 55%, transparent 75%), linear-gradient(0deg, rgba(0, 0, 0, 0.42) 0%, transparent 32%); }
  .h-seq .seq-layer { color: #f4f3ee; padding: 0 clamp(32px, 4.4vw, 64px) clamp(84px, 11vh, 120px); }
  .h-seq .h-l1, .h-seq .h-l3 { align-content: end; gap: 20px; }
  .h-seq .h-l1 .display { max-width: 9.5em; }
  .h-seq .h-l2 { align-content: center; justify-items: center; text-align: center; padding-bottom: 0; }
  .h-frame { position: absolute; inset: clamp(12px, 1.6vw, 22px); z-index: 2; border: 1px solid rgba(255, 255, 255, 0.3); pointer-events: none; }
  .h-corner { position: absolute; z-index: 3; bottom: clamp(28px, 3.4vw, 46px); color: rgba(244, 243, 238, 0.8); }
  .h-corner.l { left: clamp(32px, 4.4vw, 64px); }
  .h-corner.r { right: clamp(32px, 4.4vw, 64px); }
  .h-small { max-width: 36em; }
  .h-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }
  .h-btn { background: #f4f3ee; border-color: #f4f3ee; color: #0b0b0b; }
  .h-btn:hover { background: transparent; color: #f4f3ee; }
  .h-seq .link, .h-scene .link { color: #f4f3ee; }

  /* typographic scenes */
  .h-plate { padding-block: clamp(110px, 16vh, 190px); border-top: 1px solid var(--line); }
  .h-plate > .display { margin-bottom: clamp(48px, 7vw, 96px); }
  .h-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; }
  .h-steps li { display: grid; gap: 10px; align-content: start; padding-top: 18px; border-top: 1px solid var(--line); }

  /* work: one full picture, one framed print */
  .h-scene { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: hidden; color: #f4f3ee; }
  .h-bleed { position: absolute; inset: 0; }
  .h-bleed .ph-img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: auto; }
  .h-veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0, 0, 0, 0.58) 0%, rgba(0, 0, 0, 0.15) 55%, transparent 80%), linear-gradient(0deg, rgba(0, 0, 0, 0.4) 0%, transparent 35%); }
  .h-scene-copy { position: relative; z-index: 3; display: grid; gap: 20px; padding-block: 0 clamp(84px, 11vh, 120px); }
  .h-scene-copy .display { font-size: clamp(2.6rem, 6vw, 5.8rem); max-width: 10em; }
  .h-exhibit { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 48px 72px; align-items: end; padding-block: clamp(110px, 16vh, 190px); }
  .h-print { display: block; border: 1px solid var(--line-strong); padding: clamp(10px, 1.2vw, 16px); transition: border-color 0.3s; }
  .h-print:hover { border-color: var(--text); }
  .h-print img { width: 100%; height: auto; }
  .h-exhibit-copy { display: grid; gap: 20px; }
  .h-exhibit-copy .display { font-size: clamp(2.4rem, 4.4vw, 4.2rem); }
  .h-note { padding-bottom: 40px; }

  /* packages table */
  .h-table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
  .h-table th, .h-table td { text-align: left; font-weight: 400; padding: 14px 16px 14px 0; border-top: 1px solid var(--line); vertical-align: top; }
  .h-table thead th { border-top: 0; padding-bottom: 18px; }
  .h-table tbody th { color: var(--muted); width: 46%; }
  .h-table tfoot td { padding-top: 22px; }

  /* faq */
  .h-faq { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 48px; }
  .h-faq > .display { margin-bottom: 0; }
  .h-faq-list details { border-top: 1px solid var(--line); }
  .h-faq-list details:last-child { border-bottom: 1px solid var(--line); }
  .h-faq-list summary { display: flex; justify-content: space-between; gap: 20px; padding: 18px 0; cursor: pointer; list-style: none; }
  .h-faq-list summary::-webkit-details-marker { display: none; }
  .h-plus { color: var(--muted); transition: transform 0.3s var(--ease); }
  .h-faq-list details[open] .h-plus { transform: rotate(45deg); }
  .h-faq-list details p { padding-bottom: 20px; max-width: 40em; }

  /* contact */
  .h-contact { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 48px 96px; align-items: end; }
  .h-contact .display { margin-bottom: 20px; font-size: clamp(2.2rem, 5vw, 4.6rem); overflow-wrap: anywhere; }
  .h-contact .display a { text-decoration: none; }
  .h-contact .display a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.12em; }
  .contact-form { display: grid; gap: 22px; }
  .contact-form .field input, .contact-form .field textarea { border: 0; border-bottom: 1px solid var(--line-strong); border-radius: 0; background: transparent; padding: 10px 0; }

  @media (max-width: 900px) {
    .h-steps { grid-template-columns: 1fr 1fr; }
    .h-exhibit, .h-faq, .h-contact { grid-template-columns: 1fr; }
    .h-seq .seq-shade, .h-veil { background: linear-gradient(0deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.25) 55%, rgba(0, 0, 0, 0.12) 100%); }
    .h-corner.r { display: none; }
  }
  @media (max-width: 560px) {
    .h-steps { grid-template-columns: 1fr; }
    .h-table th, .h-table td { padding-right: 10px; }
    .h-table tbody th { width: 40%; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initScrollSequences } from '../examples/scroll-sequence.js';

  initScrollSequences({ gsap, ScrollTrigger, lenis: null, reduceMotion: matchMedia('(prefers-reduced-motion: reduce)').matches });

  // Contact form: validates, then opens the visitor's mail app with the message (no backend yet).
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    let first: HTMLInputElement | null = null;
    for (const f of form.querySelectorAll<HTMLInputElement>('[required]')) {
      const ok = f.value.trim() !== '' && f.checkValidity();
      f.setAttribute('aria-invalid', String(!ok));
      const err = document.getElementById(`${f.id}-err`);
      if (err) err.textContent = ok ? '' : f.type === 'email' && f.value ? 'Ez nem érvényes e-mail cím.' : 'Ezt a mezőt ki kell tölteni.';
      if (!ok && !first) first = f;
    }
    if (first) return first.focus();
    const d = new FormData(form);
    const body = `${d.get('message')}\n\n${d.get('name')}\n${d.get('email')}`;
    location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Kérdés a weboldalról')}&body=${encodeURIComponent(body)}`;
    form.querySelector('[role=status]')!.textContent = 'Megnyitottuk a levelezőprogramodat. Ha nem nyílt meg, írj a fenti címre.';
  });
</script>
