---
import Layout from '../layouts/Layout.astro';
import { business, formatPrice, pricing } from '../config/business';
import { url } from '../lib/url';
import { icon } from '../lib/icon';

const price = formatPrice();
---
<Layout title="Összegzés és megrendelés" description="Nézd át a weboldalad, és rendeld meg online." noindex>
  <div class="container page-head">
    <h1 class="display">Összegzés</h1>
    <p class="lede">Nézd át a weboldaladat. Ha minden rendben, add meg az adataidat, és rendeld meg.</p>
  </div>

  <div class="container checkout">
    <div class="review">
      <div class="big-preview" id="big-preview">
        <div class="devices" role="group" aria-label="Előnézet mérete">
          <button type="button" data-device="desktop" aria-pressed="true"><Fragment set:html={icon('desktop')} />Asztali</button>
          <button type="button" data-device="mobile" aria-pressed="false"><Fragment set:html={icon('mobile')} />Mobil</button>
        </div>
        <div class="preview-shell" data-device="desktop">
          <iframe id="preview" src={url('sablon/elonezet')} title="A megrendelendő weboldal előnézete"></iframe>
        </div>
      </div>

      <section class="choices-list" aria-labelledby="valasztasok">
        <div class="choices-head">
          <h2 id="valasztasok">A választásaid</h2>
          <a class="link" href={url('tervezo')}>Vissza a tervezőbe</a>
        </div>
        <dl id="summary" class="summary"></dl>
      </section>
    </div>

    <aside class="order panel" aria-labelledby="rendeles">
      <h2 id="rendeles">Megrendelés</h2>
      <div class="total">
        <div><p class="total-label">{pricing.productName}</p><p class="hint">{business.taxNote}</p></div>
        <p class="total-amount">{price}</p>
      </div>
      <form id="order-form" novalidate>
        <fieldset>
          <legend>Kapcsolattartó</legend>
          <div class="field"><label for="o-name">Teljes név</label><input id="o-name" name="name" autocomplete="name" aria-describedby="o-name-err" /><p class="field-err" id="o-name-err"></p></div>
          <div class="field"><label for="o-email">E-mail</label><input id="o-email" name="email" type="email" autocomplete="email" aria-describedby="o-email-err" /><p class="field-err" id="o-email-err"></p></div>
          <div class="field"><label for="o-phone">Telefon <span class="muted">(nem kötelező)</span></label><input id="o-phone" name="phone" type="tel" autocomplete="tel" aria-describedby="o-phone-err" /><p class="field-err" id="o-phone-err"></p></div>
        </fieldset>
        <fieldset>
          <legend>Számlázási adatok</legend>
          <div class="segmented" role="radiogroup" aria-label="Számlázás típusa">
            <label><input type="radio" name="billingType" value="person" checked /><span>Magánszemély</span></label>
            <label><input type="radio" name="billingType" value="company" /><span>Cég</span></label>
          </div>
          <div class="company-only">
            <div class="field"><label for="o-companyName">Cégnév</label><input id="o-companyName" name="companyName" autocomplete="organization" aria-describedby="o-companyName-err" /><p class="field-err" id="o-companyName-err"></p></div>
            <div class="field"><label for="o-taxNumber">Adószám</label><input id="o-taxNumber" name="taxNumber" placeholder="12345678-1-23" aria-describedby="o-taxNumber-err" /><p class="field-err" id="o-taxNumber-err"></p></div>
          </div>
          <div class="row2">
            <div class="field"><label for="o-zip">Irányítószám</label><input id="o-zip" name="zip" inputmode="numeric" autocomplete="postal-code" aria-describedby="o-zip-err" /><p class="field-err" id="o-zip-err"></p></div>
            <div class="field"><label for="o-city">Település</label><input id="o-city" name="city" autocomplete="address-level2" aria-describedby="o-city-err" /><p class="field-err" id="o-city-err"></p></div>
          </div>
          <div class="field"><label for="o-address">Utca, házszám</label><input id="o-address" name="address" autocomplete="street-address" aria-describedby="o-address-err" /><p class="field-err" id="o-address-err"></p></div>
        </fieldset>
        <div class="field"><label for="o-note">Megjegyzés <span class="muted">(nem kötelező)</span></label><textarea id="o-note" name="note" rows="2" placeholder="Például a domain neve vagy egy határidő"></textarea></div>
        <div class="consents">
          <label class="check"><input type="checkbox" name="terms" aria-describedby="o-terms-err" /><span>Elolvastam és elfogadom az <a class="link" href={url('aszf')} target="_blank">ÁSZF-et</a>.</span></label>
          <p class="field-err" id="o-terms-err"></p>
          <label class="check"><input type="checkbox" name="privacy" aria-describedby="o-privacy-err" /><span>Elolvastam az <a class="link" href={url('adatvedelem')} target="_blank">adatkezelési tájékoztatót</a>.</span></label>
          <p class="field-err" id="o-privacy-err"></p>
        </div>
        <button class="btn btn-lg buy" type="submit"><Fragment set:html={icon('lock')} />Megvásárlás – {price}</button>
        <p class="hint secure">Tesztüzem: a fizetés még nincs bekötve, kártyaterhelés nem történik.</p>
      </form>
    </aside>
  </div>

  <dialog id="pay" class="pay panel" aria-labelledby="pay-title">
    <p class="mono pay-kicker">Fizetés · tesztüzem</p>
    <h2 id="pay-title">Itt jelenik majd meg a fizetési felület</h2>
    <p class="muted">A Stripe vagy Barion fizetés még nincs bekötve. A megrendelés adatai elkészültek, és készen állnak a továbbításra.</p>
    <dl class="pay-meta">
      <div><dt>Rendelésszám</dt><dd id="pay-id" class="mono"></dd></div>
      <div><dt>Összeg</dt><dd>{price}</dd></div>
      <div><dt>Visszaigazolás ide</dt><dd id="pay-email"></dd></div>
    </dl>
    <div class="pay-actions">
      <button type="button" class="btn btn-ghost" data-pay="cancel">Mégse</button>
      <button type="button" class="btn" data-pay="confirm">Teszt fizetés jóváhagyása</button>
    </div>
  </dialog>
</Layout>

<style>
  .checkout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(340px, 420px); gap: 32px; align-items: start; padding-bottom: var(--section); }
  .review { display: grid; gap: 32px; min-width: 0; }
  .big-preview { display: grid; gap: 12px; }
  .devices { justify-self: start; display: flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); }
  .devices button { display: flex; align-items: center; gap: 6px; padding: 6px 12px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font-size: 13.5px; cursor: pointer; }
  .devices button[aria-pressed='true'] { background: var(--surface-2); color: var(--text); }
  .preview-shell { justify-self: center; width: 100%; height: min(72vh, 720px); border-radius: var(--r-media); overflow: hidden; border: 1px solid var(--line); background: #000; transition: width 0.5s var(--ease); }
  .preview-shell[data-device='mobile'] { width: 390px; max-width: 100%; border-radius: 30px; border: 8px solid #1d1d1d; }
  .preview-shell iframe { width: 100%; height: 100%; border: 0; display: block; }

  .choices-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 16px; }
  .choices-head h2 { font-size: 1.8rem; }
  .summary { display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; }
  .summary :global(div) { display: grid; grid-template-columns: 120px minmax(0, 1fr) auto; gap: 12px; align-items: baseline; padding: 14px 0; border-top: 1px solid var(--line); }
  .summary :global(dt) { color: var(--muted); font-size: 14px; }
  .summary :global(dd) { overflow-wrap: anywhere; }
  .summary :global(.dot) { display: inline-block; width: 14px; height: 14px; border-radius: 50%; margin-right: 6px; vertical-align: -2px; border: 1px solid var(--line-strong); }
  .summary :global(.edit) { font-size: 13.5px; }

  .order { position: sticky; top: calc(var(--header-h) + 16px); padding: 24px; display: grid; gap: 20px; }
  .order h2 { font-size: 1.6rem; }
  .total { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding: 16px; border-radius: var(--r-input); background: var(--surface-2); }
  .total-label { font-weight: 500; }
  .total-amount { font-family: var(--font-display); font-weight: 600; font-size: 1.7rem; letter-spacing: -0.03em; white-space: nowrap; font-variant-numeric: tabular-nums; }
  #order-form { display: grid; gap: 18px; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 14px; }
  legend { font-size: 13px; font-weight: 500; color: var(--muted); margin-bottom: 10px; padding: 0; }
  .row2 { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: 12px; }
  .segmented { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; padding: 4px; border-radius: 999px; background: var(--bg); border: 1px solid var(--line); }
  .segmented label { position: relative; }
  .segmented input { position: absolute; opacity: 0; }
  .segmented span { display: block; text-align: center; padding: 8px; border-radius: 999px; cursor: pointer; color: var(--muted); font-size: 14px; }
  .segmented input:checked + span { background: var(--surface-2); color: var(--text); }
  .segmented input:focus-visible + span { outline: 2px solid var(--accent); }
  .company-only { display: none; gap: 14px; }
  #order-form:has(input[value='company']:checked) .company-only { display: grid; }
  .consents { display: grid; gap: 6px; }
  .check { display: flex; gap: 10px; align-items: flex-start; font-size: 14.5px; cursor: pointer; }
  .check input { width: 18px; height: 18px; margin: 2px 0 0; accent-color: var(--accent); flex: none; }
  .buy { width: 100%; background: var(--accent); color: var(--on-accent); }
  .buy:hover { background: var(--text); color: var(--bg); }
  .secure { text-align: center; }

  .pay { width: min(520px, calc(100% - 32px)); padding: 28px; color: var(--text); gap: 14px; }
  .pay[open] { display: grid; }
  .pay::backdrop { background: rgba(5, 5, 5, 0.75); backdrop-filter: blur(4px); }
  .pay-kicker { color: var(--accent); }
  .pay h2 { font-size: 1.6rem; }
  .pay-meta { display: grid; gap: 6px; margin: 6px 0; }
  .pay-meta div { display: flex; justify-content: space-between; gap: 16px; padding: 10px 12px; border-radius: var(--r-input); background: var(--surface-2); font-size: 14.5px; }
  .pay-meta dt { color: var(--muted); }
  .pay-meta dd { overflow-wrap: anywhere; text-align: right; }
  .pay-actions { display: flex; justify-content: flex-end; gap: 8px; flex-wrap: wrap; }

  @media (max-width: 1000px) {
    .checkout { grid-template-columns: 1fr; }
    .order { position: static; }
    .summary { grid-template-columns: 1fr; }
    .preview-shell { height: 60vh; }
  }
  @media (max-width: 600px) {
    .devices { display: none; }
    .preview-shell, .preview-shell[data-device='mobile'] { width: 100%; border: 1px solid var(--line); border-radius: var(--r-media); }
    .summary :global(div) { grid-template-columns: 100px minmax(0, 1fr); }
    .summary :global(.edit) { grid-column: 2; }
  }
</style>

<script>
  import { loadConfig, loadCustomer, saveCustomer } from '../lib/store.js';
  import { buildOrder, validateOrder, submitOrder } from '../lib/order.js';
  import { startPayment } from '../lib/payment.js';
  import { BLOCK_LABELS, esc, pagesOf } from '../template/render.js';

  const BASE = document.documentElement.dataset.base || '/';
  const config = loadConfig();
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector(s) as T;

  // Live preview of the saved design.
  const frame = $<HTMLIFrameElement>('#preview');
  const send = () => frame.contentWindow?.postMessage({ type: 'site-config', config }, location.origin);
  frame.addEventListener('load', send);
  addEventListener('message', (e) => { if (e.origin === location.origin && e.data?.type === 'preview-ready') send(); });
  document.querySelectorAll<HTMLButtonElement>('button[data-device]').forEach((b) => b.addEventListener('click', () => {
    $('.preview-shell').setAttribute('data-device', b.dataset.device!);
    document.querySelectorAll('button[data-device]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  }));

  // Summary of the choices, each with a link back to its configurator step.
  const t = config.theme;
  const dot = (c: string) => `<span class="dot" style="background:${esc(c)}" title="${esc(c)}"></span>`;
  const allPages = pagesOf(config);
  const blockCount = allPages.reduce((n: number, p: any) => n + (p.blocks || []).filter((b: any) => !b.hidden).length, 0);
  const usedTypes = [...new Set(allPages.flatMap((p: any) => (p.blocks || []).filter((b: any) => !b.hidden).map((b: any) => BLOCK_LABELS[b.type as keyof typeof BLOCK_LABELS])))];
  const rows: [string, string, number][] = [
    ['Cégnév', esc(config.brand.name), 1],
    ['Tevékenység', esc(config.brand.activity || '-'), 1],
    ['Oldalak', esc(allPages.map((p: any) => p.title).join(', ')), 3],
    ['Blokkok', `${blockCount} blokk: ${esc(usedTypes.join(', '))}`, 3],
    ['Színek', `${dot(t.colors.primary)}${dot(t.colors.accent)}${dot(t.colors.background)}${dot(t.colors.text)} ${t.mode === 'light' ? 'világos' : 'sötét'} téma`, 2],
    ['Betűtípus', `${esc(t.headingFont)} / ${esc(t.bodyFont)}`, 2],
    ['Stílus', esc(`${{ pill: 'kerek', rounded: 'lekerekített', square: 'szögletes' }[t.buttonShape as string] || ''} gombok, ${{ none: 'animáció nélkül', subtle: 'visszafogott', normal: 'normál', strong: 'erős' }[t.motion as string] || ''} mozgás`), 2],
    ['Elérhetőség', [config.contact.address, config.contact.phone, config.contact.email].filter(Boolean).map(esc).join('<br>') || '-', 4],
  ];
  $('#summary').innerHTML = rows.map(([k, v, step]) => `<div><dt>${k}</dt><dd>${v}</dd><a class="link edit" href="${BASE}tervezo?lepes=${step}" aria-label="${k} módosítása">Módosítás</a></div>`).join('');

  // Order form: restore earlier input, validate, then run the (placeholder) payment step.
  const form = $<HTMLFormElement>('#order-form');
  const saved = loadCustomer() as Record<string, string>;
  for (const [k, v] of Object.entries(saved)) {
    const el = form.elements.namedItem(k);
    if (el instanceof RadioNodeList) el.value = v;
    else if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement) el.value = v;
  }
  const read = () => {
    const d = new FormData(form);
    const v = (k: string) => String(d.get(k) || '');
    return {
      customer: { name: v('name'), email: v('email'), phone: v('phone') },
      billing: { type: v('billingType') as 'person' | 'company', name: v('name'), companyName: v('companyName'), taxNumber: v('taxNumber'), zip: v('zip'), city: v('city'), address: v('address') },
      consents: { terms: d.has('terms'), privacy: d.has('privacy') },
      note: v('note'),
    };
  };
  form.addEventListener('input', () => {
    const d = Object.fromEntries([...new FormData(form)].filter(([k]) => !['terms', 'privacy'].includes(k)));
    saveCustomer(d);
  });

  const dialog = $<HTMLDialogElement>('#pay');
  let pending: ReturnType<typeof buildOrder> | null = null;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = read();
    const errors = validateOrder(data) as Record<string, string>;
    form.querySelectorAll('.field-err').forEach((el) => (el.textContent = ''));
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    const keys = Object.keys(errors);
    if (keys.length) {
      for (const k of keys) {
        $(`#o-${k}-err`).textContent = errors[k];
        (form.elements.namedItem(k) as HTMLElement | null)?.setAttribute('aria-invalid', 'true');
      }
      (form.elements.namedItem(keys[0]) as HTMLElement | null)?.focus();
      return;
    }
    pending = buildOrder({ siteConfig: config, ...data });
    const result = await startPayment(pending);
    if (result.status === 'redirect') return void (location.href = result.url);
    $('#pay-id').textContent = pending.orderId;
    $('#pay-email').textContent = pending.customer.email;
    dialog.showModal();
  });

  dialog.addEventListener('click', async (e) => {
    const action = (e.target as HTMLElement).closest<HTMLElement>('[data-pay]')?.dataset.pay;
    if (action === 'cancel') dialog.close();
    if (action === 'confirm' && pending) {
      await submitOrder(pending);
      location.href = `${BASE}koszonjuk`;
    }
  });
</script>
